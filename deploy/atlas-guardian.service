[Unit]
Description=Atlas Guardian page, link and browser sweep
After=network-online.target atlas.service

[Service]
Type=oneshot
User=administrator
WorkingDirectory=/opt/atlas
EnvironmentFile=/etc/atlas/guardian.env
ExecStart=/usr/bin/node --env-file=.env.local --import tsx scripts/guardian/worker.ts
TimeoutStartSec=40min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
