model ContractDocument {
  id String @id @default(cuid())
  organisationId String
  reference String
  title String
  bodyHtml String @db.Text
  partyId String?
  contactId String?
  quoteId String?
  orderId String?
  status String @default("DRAFT")
  tokenHash String @unique
  expiresAt DateTime?
  sentAt DateTime?
  viewedAt DateTime?
  signedAt DateTime?
  signerName String?
  signerEmail String?
  signerIp String?
  declinedReason String?
  contentHash String @default("")
  /** CONTRACT is a document to sign. QUOTE is a quotation sent for the customer to approve. */
  kind String @default("CONTRACT")
  /** Shown to the signer above the document. */
  message String @default("") @db.Text
  /** The PDF the signer reads. For a quotation this is the copy as it stood when it was sent. */
  fileName String?
  fileType String?
  fileSize Int?
  fileContent Bytes?
  signerUserAgent String?
  /** Drawn signature as a PNG data URL, when the signer drew one. */
  signatureImage String? @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organisationId,reference])
  @@index([organisationId,status])
  @@map("contract_documents")
}

model CsatSurvey {
  id String @id @default(cuid())
  organisationId String
  name String
  question String
  followUpQuestion String @default("Anything we could do better?")
  /** Asked instead of the follow-up when the score is 3 or lower. Empty means use the follow-up. */
  lowFollowUpQuestion String @default("")
  /** Things the customer can tick to say what the score was about. */
  reasons String[] @default([])
  lowLabel String @default("Very unhappy")
  highLabel String @default("Very happy")
  /** The email that carries the survey when an automation uses no email template. Merge fields allowed. */
  emailSubject String @default("")
  emailIntro String @default("") @db.Text
  thanksText String @default("Thank you for your feedback.")
  scale Int @default(5)
  context String @default("GENERAL")
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  responses CsatResponse[]
  @@unique([id,organisationId])
  @@map("csat_surveys")
}

model CsatResponse {
  id String @id @default(cuid())
  organisationId String
  surveyId String
  token String @unique
  partyId String?
  contactId String?
  email String?
  entityType String?
  entityId String?
  score Int?
  comment String?
  reasons String[] @default([])
  sentAt DateTime @default(now())
  respondedAt DateTime?
  automationRunId String?
  survey CsatSurvey @relation(fields:[surveyId,organisationId],references:[id,organisationId],onDelete:Cascade)
  @@index([organisationId,surveyId,respondedAt])
  @@index([organisationId,partyId])
  @@map("csat_responses")
}

