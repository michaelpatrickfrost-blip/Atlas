// Atlas core data model.
// Core owns platform concerns (org, users, auth, permissions, audit, activity).
// Modules own business entities but share Party/Organisation/Currency concepts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Core: tenancy & identity ----------

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  moduleStates ModuleState[]
  parties      Party[]
  auditEntries AuditEntry[]
  activities   Activity[]

  // Sales module entities (tenant-scoped)
  opportunities Opportunity[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  prospects       Prospect[]
  pipelines       Pipeline[]
  salesTeams      SalesTeam[]
  lossReasons     LossReason[]
  salesActivities SalesActivity[]

  @@map("organisations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// A user's membership of an org, carrying the roles that grant capabilities.
model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        RoleOnMembership[]

  @@unique([organisationId, userId])
  @@map("memberships")
}

// A role bundles capability strings. Roles are org-scoped so an org can customise them,
// but modules/seed data create a standard set per org on creation.
model Role {
  id             String   @id @default(cuid())
  organisationId String
  key            String // e.g. "admin", "sales_manager"
  name           String
  capabilities   String[] // e.g. ["sales.quote.read", "sales.quote.approve"]
  createdAt      DateTime @default(now())

  memberships RoleOnMembership[]

  @@unique([organisationId, key])
  @@map("roles")
}

model RoleOnMembership {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("roles_on_memberships")
}

// ---------- Core: module registry ----------

// Persisted enable/disable state per org. The module catalogue itself (manifest,
// capabilities, nav, routes) lives in code — see src/modules/registry.ts.
model ModuleState {
  id             String   @id @default(cuid())
  organisationId String
  moduleId       String
  enabled        Boolean  @default(false)
  installedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleId])
  @@map("module_states")
}

// ---------- Core: Customer Master (canonical Party + extensions) ----------
//
// A Party is any real-world actor a business deals with: a company or a person.
// Modules attach their own records (Opportunity, Quote, Invoice, Ticket, ...) to a
// Party rather than each inventing their own "Customer" copy — see docs/CUSTOMER_MASTER.md
// for the full architecture (one identity, module-contributed Overview sections,
// capability-gated sensitive data, duplicate detection, multi-company deferral).
//
// Identity lives on Party itself. Commercial/credit configuration is split into
// their own 1:1 tables so each is independently section-editable (never one giant
// edit form) and so a future multi-company override can attach per-company rows
// without touching identity.
model Party {
  id             String         @id @default(cuid())
  organisationId String
  kind           PartyKind
  name           String // legal name
  tradingName    String?
  customerCode   String // e.g. "C000184", unique per org, assigned at creation
  status         CustomerStatus @default(PROSPECT)
  customerGroup  String?
  parentPartyId  String?

  website                String?
  industry               String?
  registrationNumber     String?
  countryOfRegistration  String?
  relationshipStartDate  DateTime?
  accountManagerUserId   String? // soft reference to User.id — see docs/CUSTOMER_MASTER.md
  territory              String?
  tags                   String[]
  preferredLanguage      String?
  preferredCurrency      String  @default("GBP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       Party?       @relation("PartyHierarchy", fields: [parentPartyId], references: [id])
  children     Party[]      @relation("PartyHierarchy")

  contacts                 Contact[]
  addresses                Address[]
  communicationDestinations CommunicationDestination[]
  taxRegistrations         TaxRegistration[]
  bankAccounts             BankAccount[]
  directDebitMandates      DirectDebitMandate[]
  documents                Document[]
  notes                    Note[]
  commercialSettings       CustomerCommercialSettings?
  creditProfile            CustomerCreditProfile?
  activities               Activity[]

  opportunities Opportunity[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  prospects       Prospect[]
  salesActivities SalesActivity[]

  @@unique([organisationId, customerCode])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("parties")
}

enum PartyKind {
  COMPANY
  PERSON
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  INACTIVE
  CLOSED
}

// A person associated with a Party. One person, many roles — never duplicated
// per function (§9).
model Contact {
  id             String        @id @default(cuid())
  partyId        String
  title          String?
  firstName      String
  middleName     String?
  surname        String
  preferredName  String?
  jobTitle       String?
  department     String?
  email          String?
  alternativeEmail String?
  phone          String?
  mobile         String?
  preferredContactMethod ContactPreferredMethod?
  language       String?
  notes          String?
  status         ContactStatus @default(ACTIVE)
  isPrimary      Boolean       @default(false)
  roles          ContactRole[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  party                     Party                      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  communicationDestinations CommunicationDestination[]
  addresses                 Address[]
  opportunityStakeholders   OpportunityStakeholder[]
  opportunitiesAsPrimaryContact Opportunity[]

  @@index([partyId])
  @@map("contacts")
}

enum ContactPreferredMethod {
  EMAIL
  PHONE
  MOBILE
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactRole {
  PRIMARY
  SALES
  ACCOUNTS_PAYABLE
  PURCHASING
  OPERATIONS
  DELIVERY
  TECHNICAL
  EXECUTIVE
  OTHER
}

// Which contact/email a given document type goes to — not every document goes
// to the same inbox (§10). Falls back to the contact marked primary when unset.
model CommunicationDestination {
  id        String                 @id @default(cuid())
  partyId   String
  purpose   CommunicationPurpose
  contactId String?
  email     String?
  createdAt DateTime               @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId, purpose])
  @@map("communication_destinations")
}

enum CommunicationPurpose {
  ORDERS
  INVOICES
  STATEMENTS
  CREDIT_CONTROL
  DELIVERY
}

model Address {
  id        String      @id @default(cuid())
  partyId   String
  type      AddressType @default(OTHER)
  label     String?
  locationName String?
  line1     String
  line2     String?
  city      String?
  region    String?
  postcode  String?
  country   String?
  telephone String?
  contactId String?
  deliveryInstructions String?
  active    Boolean     @default(true)
  isDefaultBilling  Boolean @default(false)
  isDefaultDelivery Boolean @default(false)
  createdAt DateTime    @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId])
  @@map("addresses")
}

enum AddressType {
  REGISTERED
  BILLING
  DELIVERY
  SITE
  SERVICE
  OFFICE
  OTHER
}

// ---------- Customer Master: Commercial ----------

model CustomerCommercialSettings {
  partyId String @id

  secondaryAccountManagerUserId String?
  customerSegment                String?
  priceList                      String?
  discountGroup                  String?
  pricingAgreementReference      String?

  customerPoRequired       Boolean @default(false)
  poFormatRules             String?
  orderReferenceRequired    Boolean @default(false)
  partialShipmentAllowed    Boolean @default(true)
  backordersAllowed         Boolean @default(true)

  defaultDeliveryAddressId String?
  deliveryMethod            String?
  shippingTerms              String?
  preferredWarehouse         String?
  shippingAccountReference   String?

  quoteTemplate                  String?
  orderConfirmationPreference    String?
  invoiceDeliveryPreference      String?

  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("customer_commercial_settings")
}

// ---------- Customer Master: Credit & payment ----------

model PaymentTerm {
  id             String          @id @default(cuid())
  organisationId String
  key            String
  name           String
  days           Int?
  type           PaymentTermType @default(NET)
  createdAt      DateTime        @default(now())

  creditProfiles CustomerCreditProfile[]

  @@unique([organisationId, key])
  @@map("payment_terms")
}

enum PaymentTermType {
  DUE_ON_RECEIPT
  NET
  END_OF_MONTH
  CUSTOM
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  CHEQUE
  ACCOUNT
  OTHER
}

// Customer-level credit configuration. Calculated exposure (open invoices + open
// orders) is NOT stored here — it's supplied by Finance/Sales through their own
// queries, never duplicated into Customer Master (§16).
model CustomerCreditProfile {
  partyId String @id

  creditLimitAmount   Int     @default(0)
  creditLimitCurrency String  @default("GBP")
  onHold              Boolean @default(false)
  holdReason          String?
  holdDate            DateTime?
  holdSetByUserId     String?
  reviewDate          DateTime?
  riskRating          String?
  insuranceLimitAmount Int?
  collectionsStatus   String?
  statementFrequency  String?
  reminderPolicy      String?
  paymentTermId       String?
  paymentMethod       PaymentMethod?

  updatedAt DateTime @updatedAt

  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  @@map("customer_credit_profiles")
}

// ---------- Customer Master: Tax ----------

// A customer may hold several tax registrations across jurisdictions. Format
// validation and external verification are tracked separately (§19–20) — Atlas
// never claims a number is verified unless a real check (manual or service) was
// actually recorded.
model TaxRegistration {
  id                 String               @id @default(cuid())
  partyId            String
  jurisdiction       String // ISO country/region code, e.g. "GB", "XI"
  registrationType   String // e.g. "VAT", "GST"
  number             String
  normalizedNumber   String // whitespace/case-normalised, used for matching/search
  effectiveDate      DateTime?
  expiryDate         DateTime?
  validationStatus   TaxValidationStatus @default(NOT_VERIFIED)
  validationDate     DateTime?
  validationSource   String? // "manual" today; a future service name once integrated
  verifiedLegalName  String?
  verifiedAddress    String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([normalizedNumber])
  @@map("tax_registrations")
}

enum TaxValidationStatus {
  NOT_VERIFIED
  MANUALLY_VERIFIED
  VERIFIED_BY_SERVICE
  FAILED
}

// ---------- Customer Master: Bank & Direct Debit ----------
//
// Sensitive. Raw values are stored (this environment has no KMS/secrets
// infrastructure to encrypt at rest — see docs/CUSTOMER_MASTER.md §Security for
// the honest limitation and what a production deployment must add). Every read
// path masks by default; only a capability-gated, audited reveal action returns
// the full value. Never included in global search results or bulk exports.
model BankAccount {
  id             String                 @id @default(cuid())
  partyId        String
  accountHolder  String
  bankName       String?
  label          String?
  country        String
  currency       String
  sortCode       String?
  accountNumber  String?
  iban           String?
  bic            String?
  purpose        BankAccountPurpose     @default(OTHER)
  active         Boolean                @default(true)
  isDefault      Boolean                @default(false)
  verifiedStatus BankVerificationStatus @default(NOT_VERIFIED)
  verifiedDate   DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  party           Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  directDebitMandates DirectDebitMandate[]

  @@index([partyId])
  @@map("bank_accounts")
}

enum BankAccountPurpose {
  DIRECT_DEBIT
  REFUND
  REMITTANCE
  OTHER
}

enum BankVerificationStatus {
  NOT_VERIFIED
  VERIFIED
}

model DirectDebitMandate {
  id                 String               @id @default(cuid())
  partyId            String
  bankAccountId      String
  scheme             DirectDebitScheme
  mandateReference   String
  status             DirectDebitStatus    @default(PENDING)
  agreedDate         DateTime?
  effectiveDate      DateTime?
  firstCollectionDate DateTime?
  lastCollectionDate DateTime?
  cancellationDate   DateTime?
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party       Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([partyId, mandateReference])
  @@map("direct_debit_mandates")
}

enum DirectDebitScheme {
  BACS
  SEPA_CORE
  SEPA_B2B
}

enum DirectDebitStatus {
  PENDING
  ACTIVE
  CANCELLED
  FAILED
}

// ---------- Customer Master: Documents & notes ----------

model Document {
  id             String             @id @default(cuid())
  organisationId String
  partyId        String?
  type           String // e.g. "VAT certificate", "Signed terms"
  date           DateTime?
  expiryDate     DateTime?
  description    String?
  uploadedByUserId String?
  visibility     DocumentVisibility @default(ALL)
  url            String? // external storage reference — no file upload infra yet
  createdAt      DateTime           @default(now())

  party Party? @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("documents")
}

enum DocumentVisibility {
  ALL
  RESTRICTED
}

model Note {
  id             String   @id @default(cuid())
  partyId        String
  body           String
  pinned         Boolean  @default(false)
  restricted     Boolean  @default(false)
  authorUserId   String?
  createdAt      DateTime @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("notes")
}

// ---------- Core: audit & activity ----------

model AuditEntry {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String // e.g. "quote.approved"
  entityType     String // e.g. "Quote"
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
  @@map("audit_entries")
}

// A shared activity feed. Modules emit activities through the event bus; Home and
// record pages render them without Core knowing module-specific shapes.
model Activity {
  id             String   @id @default(cuid())
  organisationId String
  type           String // e.g. "sales_order.confirmed"
  summary        String
  entityType     String?
  entityId       String?
  // Optional link to the customer this activity relates to, independent of
  // entityType/entityId (which point at the Opportunity/Quote/Order/etc. that
  // generated it). This is what powers the unified customer Activity timeline
  // (§29) without Customer Master needing to know every module's entity shape.
  partyId        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([partyId, createdAt])
  @@map("activities")
}

// ---------- Sales & CRM (reference implementation) ----------
//
// See docs/modules/SALES_CRM.md for the full architecture: the
// Prospect→Opportunity→Customer journey, configurable pipelines, the
// work-prioritisation engine behind Today, stage/value history, forecast
// categories, and what's deliberately deferred (sequences, email/calendar/
// telephony integration, AI, full custom reporting).

model SalesTeam {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  managerUserId  String?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      SalesTeamMember[]
  opportunities Opportunity[]
  prospects     Prospect[]

  @@map("sales_teams")
}

model SalesTeamMember {
  teamId String
  userId String

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("sales_team_members")
}

// A configurable sales process. Businesses may run several (New Business,
// Renewals, Enterprise, ...) side by side — see §38 of the brief.
model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation  Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_pipelines")
}

// Won/Lost are terminal OpportunityStatus values, not ordinary draggable
// stages (§39) — PipelineStage only models the open, in-process stages.
model PipelineStage {
  id                String   @id @default(cuid())
  pipelineId        String
  key               String
  name              String
  order             Int
  defaultProbability Int     @default(0) // 0-100
  guidance          String?
  typicalDurationDays Int?

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
  @@map("sales_pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

enum RecurringPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model LossReason {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  label          String
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_loss_reasons")
}

enum OpportunityStakeholderRole {
  DECISION_MAKER
  ECONOMIC_BUYER
  CHAMPION
  TECHNICAL_BUYER
  USER
  PROCUREMENT
  LEGAL
  INFLUENCER
  BLOCKER
  OTHER
}

// The buying committee (§42) — one contact may hold more than one role.
model OpportunityStakeholder {
  id            String                       @id @default(cuid())
  opportunityId String
  contactId     String
  roles         OpportunityStakeholderRole[]
  createdAt     DateTime                     @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, contactId])
  @@map("sales_opportunity_stakeholders")
}

enum MilestoneStatus {
  PENDING
  DONE
}

// A lightweight Deal Plan (§46) — ordered milestones, nothing more
// elaborate. Optional; most opportunities will have none.
model OpportunityMilestone {
  id            String          @id @default(cuid())
  opportunityId String
  label         String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  order         Int
  createdAt     DateTime        @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, order])
  @@map("sales_opportunity_milestones")
}

enum OpportunityChangeType {
  STAGE
  VALUE
  CLOSE_DATE
  OWNER
  FORECAST_CATEGORY
}

// Deal change history (§50) — stored at the moment of change, never
// reconstructed later. Powers stage age, close-date slippage and pipeline
// inspection.
model OpportunityChangeEvent {
  id            String                 @id @default(cuid())
  opportunityId String
  type          OpportunityChangeType
  fromValue     String?
  toValue       String?
  changedByUserId String?
  createdAt     DateTime               @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("sales_opportunity_change_events")
}

model Opportunity {
  id             String   @id @default(cuid())
  organisationId String
  partyId        String
  prospectId     String?  @unique
  name           String

  pipelineId String
  stageId    String
  status     OpportunityStatus @default(OPEN)
  stageEnteredAt DateTime @default(now())

  valueAmount          Int // minor units
  valueCurrency        String  @default("GBP")
  recurringValueAmount Int?
  recurringPeriod      RecurringPeriod?

  probability       Int? // 0-100; defaults from stage, overridable
  forecastCategory  ForecastCategory @default(PIPELINE)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  // The next-action principle (§36) — every open opportunity should have one.
  nextActionNote String?
  nextActionAt   DateTime?

  ownerUserId String
  teamId      String?
  territory   String?

  source            String?
  campaign          String?
  primaryContactId  String?

  // Freeform qualification Q&A (guided-selling playbooks are deferred — see
  // docs/modules/SALES_CRM.md — this is the honest placeholder for their
  // structured output).
  qualificationNotes Json?
  useCase            String?
  painPoint          String?

  lossReasonId String?
  lossNotes    String?
  competitor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party          Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  team           SalesTeam?    @relation(fields: [teamId], references: [id])
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [id])
  lossReason     LossReason?   @relation(fields: [lossReasonId], references: [id])

  quotes        Quote[]
  stakeholders  OpportunityStakeholder[]
  milestones    OpportunityMilestone[]
  changeEvents  OpportunityChangeEvent[]
  activities    SalesActivity[]

  @@index([organisationId, status])
  @@index([organisationId, pipelineId, stageId])
  @@index([organisationId, ownerUserId])
  @@map("sales_opportunities")
}

enum ProspectLifecycleStage {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  DISQUALIFIED
  CONVERTED
}

// Someone/some organisation we may want to sell to — deliberately distinct
// from Opportunity (a genuine potential sale) and from the canonical
// Customer (Party). See §9 and docs/modules/SALES_CRM.md §Prospect boundary.
model Prospect {
  id             String   @id @default(cuid())
  organisationId String

  // Identity. partyId is set once the prospect is linked to (or created as)
  // a canonical Party — never a separate prospect-only company record once
  // that link exists.
  partyId      String?
  companyName  String
  contactFirstName String?
  contactSurname   String?
  jobTitle     String?
  email        String?
  phone        String?
  website      String?
  country      String?

  ownerUserId String?
  teamId      String?
  territory   String?

  // Origin — original source is never overwritten; see §11.
  source          String?
  sourceDetail    String?
  campaign        String?
  referrer        String?
  originalSource  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?

  lifecycleStage ProspectLifecycleStage @default(NEW)

  // Explainable scoring (§16-20) — each dimension stored independently with
  // its contributing factors, never a single opaque number.
  fitScore        Int?
  fitFactors        Json?
  engagementScore Int?
  engagementFactors Json?
  intentScore     Int?
  intentFactors     Json?
  priorityScore   Int?

  estimatedValueAmount   Int?
  estimatedValueCurrency String? @default("GBP")
  timeframe              String?
  notes                  String?

  isTargetAccount Boolean @default(false)
  accountTier     String?

  disqualifiedReason String?
  nurtureReason      String?
  nextReviewAt       DateTime?

  nextActivityAt   DateTime?
  firstContactedAt DateTime?
  lastContactedAt  DateTime?
  assignedAt       DateTime?
  convertedAt      DateTime?
  disqualifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id])
  team         SalesTeam?   @relation(fields: [teamId], references: [id])
  opportunity  Opportunity?
  activities   SalesActivity[]

  @@index([organisationId, lifecycleStage])
  @@index([organisationId, ownerUserId])
  @@map("sales_prospects")
}

enum SalesActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  FOLLOW_UP
  DEMO
  SITE_VISIT
  PROPOSAL
  OTHER
}

// A unified activity log for prospecting and opportunity work (§35-36).
// Distinct from the shared Atlas Activity feed (core/activity) — that's a
// read-only rendered timeline; SalesActivity is the working record sellers
// complete/schedule against, and completing one may write an Atlas Activity
// entry for the customer-facing timeline.
model SalesActivity {
  id             String            @id @default(cuid())
  organisationId String
  type           SalesActivityType
  subject        String
  notes          String?
  ownerUserId    String

  partyId       String?
  prospectId    String?
  opportunityId String?

  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id])
  prospect     Prospect?    @relation(fields: [prospectId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([organisationId, ownerUserId, dueAt])
  @@index([organisationId, completedAt])
  @@map("sales_activities")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id             String      @id @default(cuid())
  organisationId String
  partyId        String
  opportunityId  String?
  reference      String
  status         QuoteStatus @default(DRAFT)
  totalAmount    Int
  totalCurrency  String      @default("GBP")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  lines        QuoteLine[]
  salesOrder   SalesOrder?

  @@unique([organisationId, reference])
  @@map("sales_quotes")
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Int
  unitAmount  Int
  currency    String @default("GBP")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("sales_quote_lines")
}

enum SalesOrderStatus {
  CONFIRMED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id             String           @id @default(cuid())
  organisationId String
  partyId        String
  quoteId        String?          @unique
  reference      String
  status         SalesOrderStatus @default(CONFIRMED)
  totalAmount    Int
  totalCurrency  String           @default("GBP")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  quote        Quote?       @relation(fields: [quoteId], references: [id])

  @@unique([organisationId, reference])
  @@map("sales_orders")
}
