  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan            BusinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  basedOn         PlanVersion? @relation("VersionLineage", fields: [basedOnId], references: [id], onDelete: SetNull)
  derived         PlanVersion[] @relation("VersionLineage")
