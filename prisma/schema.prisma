model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  authVersion Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  platformAdmin PlatformAdministrator?
  memberships Membership[]
  employeeProfiles Employee[]

  @@map("users")
}

// A user's membership of an org, carrying the roles that grant capabilities.
model Membership {
  workTeamMemberships WorkTeamMember[]
  planningAssignments ProductionPlanLine[]
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  active Boolean @default(true)
  sessionVersion Int @default(0)
  grantedCapabilities String[] @default([])
  deniedCapabilities String[] @default([])
  lastLoginAt DateTime?
  passwordResets PasswordReset[]
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        RoleOnMembership[]

  @@unique([organisationId, userId])
  @@map("memberships")
}

// A role bundles capability strings. Roles are org-scoped so an org can customise them,
// but modules/seed data create a standard set per org on creation.
model Role {
  id             String   @id @default(cuid())
  organisationId String
  key            String // e.g. "admin", "sales_manager"
  name           String
  capabilities   String[] // e.g. ["sales.quote.read", "sales.quote.approve"]
  createdAt      DateTime @default(now())

  memberships RoleOnMembership[]

  @@unique([organisationId, key])
  @@map("roles")
}

model RoleOnMembership {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("roles_on_memberships")
}

// ---------- Core: module registry ----------

// Persisted enable/disable state per org. The module catalogue itself (manifest,
// capabilities, nav, routes) lives in code — see src/modules/registry.ts.
model ModuleState {
  id             String   @id @default(cuid())
  organisationId String
  moduleId       String
  enabled        Boolean  @default(false)
  entitled Boolean @default(false)
  installedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleId])
  @@map("module_states")
}

// ---------- Core: Customer Master (canonical Party + extensions) ----------
//
// A Party is any real-world actor a business deals with: a company or a person.
// Modules attach their own records (Opportunity, Quote, Invoice, Ticket, ...) to a
// Party rather than each inventing their own "Customer" copy — see docs/CUSTOMER_MASTER.md
// for the full architecture (one identity, module-contributed Overview sections,
// capability-gated sensitive data, duplicate detection, multi-company deferral).
//
// Identity lives on Party itself. Commercial/credit configuration is split into
// their own 1:1 tables so each is independently section-editable (never one giant
// edit form) and so a future multi-company override can attach per-company rows
// without touching identity.
model CustomerTradingLink {
  id String @id @default(cuid())
  organisationId String
  accountId String
  tradingAccountId String
  active Boolean @default(true)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  account Party @relation("TradingSource",fields:[accountId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  tradingAccount Party @relation("TradingTarget",fields:[tradingAccountId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@unique([organisationId,accountId,tradingAccountId])
  @@index([organisationId,tradingAccountId,active])
  @@map("customer_trading_links")
}

model Party {
  financeDocuments FinanceDocument[]
  financeSuppliers FinanceSupplier[]
  marketingProfiles MarketingProfile[]
  serviceCases ServiceCase[]
  fulfilments FulfilmentRequirement[]
  shipments Shipment[]
  returnAuthorisations ReturnAuthorisation[]
  id             String         @id @default(cuid())
  organisationId String
  kind           PartyKind
  name           String // legal name
  tradingName    String?
  customerCode   String // e.g. "C000184", unique per org, assigned at creation
  status         CustomerStatus @default(PROSPECT)
  hierarchyRole String @default("CUSTOMER")
  customerGroup  String?
  parentPartyId  String?

  website                String?
  industry               String?
  registrationNumber     String?
  countryOfRegistration  String?
  relationshipStartDate  DateTime?
  accountManagerUserId   String? // soft reference to User.id — see docs/CUSTOMER_MASTER.md
  territory              String?
  tags                   String[]
  preferredLanguage      String?
  preferredCurrency      String  @default("GBP")
  archived               Boolean @default(false)
  identityScrubbed       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       Party?       @relation("PartyHierarchy", fields: [parentPartyId], references: [id])
  children     Party[]      @relation("PartyHierarchy")
  projects Project[]

  contacts                 Contact[]
  addresses                Address[]
  communicationDestinations CommunicationDestination[]
  taxRegistrations         TaxRegistration[]
  bankAccounts             BankAccount[]
  directDebitMandates      DirectDebitMandate[]
  documents                Document[]
  notes                    Note[]
  commercialSettings       CustomerCommercialSettings?
  invoiceTemplates         CustomerInvoiceTemplate[]
  creditProfile            CustomerCreditProfile?
  activities               Activity[]

  opportunities Opportunity[]
  salesProjectOrganisations SalesProjectOrganisation[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  salesAgreements SalesAgreement[]
  pricedAgreements SalesAgreement[] @relation("AgreementPricingAccount")
  prospects       Prospect[]
  salesActivities SalesActivity[]
  customerProducts CustomerProduct[]
  commercialAgreements CommercialAgreement[]

  @@unique([id,organisationId])
  @@unique([organisationId, customerCode])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("parties")
  tradingLinks CustomerTradingLink[] @relation("TradingSource")
  suppliedForAccounts CustomerTradingLink[] @relation("TradingTarget")
  pricedQuotes Quote[] @relation("QuotePricingAccount")
  pricedOrders SalesOrder[] @relation("OrderPricingAccount")

}

enum PartyKind {
  COMPANY
  PERSON
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  INACTIVE
  CLOSED
}

// A person associated with a Party. One person, many roles — never duplicated
// per function (§9).
model Contact {
  marketingProfile MarketingProfile?
  id             String        @id @default(cuid())
  partyId        String
  title          String?
  firstName      String
  middleName     String?
  surname        String
  preferredName  String?
  jobTitle       String?
  department     String?
  email          String?
  alternativeEmail String?
  phone          String?
  mobile         String?
  preferredContactMethod ContactPreferredMethod?
  language       String?
  notes          String?
  status         ContactStatus @default(ACTIVE)
  identityScrubbed Boolean @default(false)
  isPrimary      Boolean       @default(false)
  roles          ContactRole[]
  reportsToContactId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  party                     Party                      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  reportsTo                 Contact?                   @relation("ContactReportsTo", fields: [reportsToContactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  directReports             Contact[]                  @relation("ContactReportsTo")
  chatParticipants          ChatParticipant[]
  communicationDestinations CommunicationDestination[]
  addresses                 Address[]
  opportunityStakeholders   OpportunityStakeholder[]
  salesProjectStakeholders  SalesProjectStakeholder[]
  opportunitiesAsPrimaryContact Opportunity[]

  @@index([partyId])
  @@index([reportsToContactId])
  @@map("contacts")
  @@unique([id,partyId])
}

enum ContactPreferredMethod {
  EMAIL
  PHONE
  MOBILE
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactRole {
  PRIMARY
  SALES
  ACCOUNTS_PAYABLE
  PURCHASING
  OPERATIONS
  DELIVERY
  TECHNICAL
  EXECUTIVE
  OTHER
}

// Which contact/email a given document type goes to — not every document goes
// to the same inbox (§10). Falls back to the contact marked primary when unset.
model CommunicationDestination {
  id        String                 @id @default(cuid())
  partyId   String
  purpose   CommunicationPurpose
  contactId String?
  email     String?
  createdAt DateTime               @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId, purpose])
  @@map("communication_destinations")
}

enum CommunicationPurpose {
  ORDERS
  INVOICES
  STATEMENTS
  CREDIT_CONTROL
  DELIVERY
}

model Address {
  id        String      @id @default(cuid())
  partyId   String
  type      AddressType @default(OTHER)
  label     String?
  locationName String?
  line1     String
  line2     String?
  city      String?
  region    String?
  postcode  String?
  country   String?
  telephone String?
  contactId String?
  deliveryInstructions String?
  active    Boolean     @default(true)
  isDefaultBilling  Boolean @default(false)
  isDefaultDelivery Boolean @default(false)
  createdAt DateTime    @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId])
  @@map("addresses")
}

enum AddressType {
  REGISTERED
  BILLING
  DELIVERY
  SITE
  SERVICE
  OFFICE
  OTHER
}

// ---------- Customer Master: Commercial ----------

model CustomerCommercialSettings {
  partyId String @id

  secondaryAccountManagerUserId String?
  customerSegment                String?
  priceList                      String?
  defaultPriceList PriceList? @relation("CustomerDefaultPriceList", fields: [priceList], references: [id], onDelete: SetNull)
  discountGroup                  String?
  pricingAgreementReference      String?

  customerPoRequired       Boolean @default(false)
  poFormatRules             String?
  orderReferenceRequired    Boolean @default(false)
  partialShipmentAllowed    Boolean @default(true)
  backordersAllowed         Boolean @default(true)

  defaultDeliveryAddressId String?
  deliveryMethod            String?
  shippingTerms              String?
  preferredWarehouse         String?
  shippingAccountReference   String?

  quoteTemplate                  String?
  orderConfirmationPreference    String?
  invoiceDeliveryPreference      String?

  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("customer_commercial_settings")
}

// ---------- Customer Master: Credit & payment ----------

model PaymentTerm {
  id             String          @id @default(cuid())
  organisationId String
  key            String
  name           String
  days           Int?
  type           PaymentTermType @default(NET)
  createdAt      DateTime        @default(now())

  creditProfiles CustomerCreditProfile[]
  quotes Quote[]
  salesOrders    SalesOrder[]
  salesAgreements SalesAgreement[]

  @@unique([organisationId, key])
  @@map("payment_terms")
}

enum PaymentTermType {
  DUE_ON_RECEIPT
  NET
  END_OF_MONTH
  CUSTOM
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  CHEQUE
  ACCOUNT
  OTHER
}

// Customer-level credit configuration. Calculated exposure (open invoices + open
// orders) is NOT stored here — it's supplied by Finance/Sales through their own
// queries, never duplicated into Customer Master (§16).
model CustomerCreditProfile {
  partyId String @id

  creditLimitAmount   Int     @default(0)
  creditLimitCurrency String  @default("GBP")
  onHold              Boolean @default(false)
  holdReason          String?
  holdDate            DateTime?
  holdSetByUserId     String?
  reviewDate          DateTime?
  riskRating          String?
  insuranceLimitAmount Int?
  collectionsStatus   String?
  statementFrequency  String?
  reminderPolicy      String?
  paymentTermId       String?
  paymentMethod       PaymentMethod?

  updatedAt DateTime @updatedAt

  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  @@map("customer_credit_profiles")
}

// ---------- Customer Master: Tax ----------

// A customer may hold several tax registrations across jurisdictions. Format
// validation and external verification are tracked separately (§19–20) — Atlas
// never claims a number is verified unless a real check (manual or service) was
// actually recorded.
model TaxRegistration {
  id                 String               @id @default(cuid())
  partyId            String
  jurisdiction       String // ISO country/region code, e.g. "GB", "XI"
  registrationType   String // e.g. "VAT", "GST"
  number             String
  normalizedNumber   String // whitespace/case-normalised, used for matching/search
  effectiveDate      DateTime?
  expiryDate         DateTime?
  validationStatus   TaxValidationStatus @default(NOT_VERIFIED)
  validationDate     DateTime?
  validationSource   String? // "manual" today; a future service name once integrated
  verifiedLegalName  String?
  verifiedAddress    String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([normalizedNumber])
  @@map("tax_registrations")
}

enum TaxValidationStatus {
  NOT_VERIFIED
  MANUALLY_VERIFIED
  VERIFIED_BY_SERVICE
  FAILED
}

// ---------- Customer Master: Bank & Direct Debit ----------
//
// Sensitive. Raw values are stored (this environment has no KMS/secrets
// infrastructure to encrypt at rest — see docs/CUSTOMER_MASTER.md §Security for
// the honest limitation and what a production deployment must add). Every read
// path masks by default; only a capability-gated, audited reveal action returns
// the full value. Never included in global search results or bulk exports.
model BankAccount {
  id             String                 @id @default(cuid())
  partyId        String
  accountHolder  String
  bankName       String?
  label          String?
  country        String
  currency       String
  sortCode       String?
  accountNumber  String?
  iban           String?
  bic            String?
  purpose        BankAccountPurpose     @default(OTHER)
  active         Boolean                @default(true)
  isDefault      Boolean                @default(false)
  verifiedStatus BankVerificationStatus @default(NOT_VERIFIED)
  verifiedDate   DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  party           Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  directDebitMandates DirectDebitMandate[]

  @@index([partyId])
  @@map("bank_accounts")
}

enum BankAccountPurpose {
  DIRECT_DEBIT
  REFUND
  REMITTANCE
  OTHER
}

enum BankVerificationStatus {
  NOT_VERIFIED
  VERIFIED
}

model DirectDebitMandate {
  id                 String               @id @default(cuid())
  partyId            String
  bankAccountId      String
  scheme             DirectDebitScheme
  mandateReference   String
  status             DirectDebitStatus    @default(PENDING)
  agreedDate         DateTime?
  effectiveDate      DateTime?
  firstCollectionDate DateTime?
  lastCollectionDate DateTime?
  cancellationDate   DateTime?
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party       Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([partyId, mandateReference])
  @@map("direct_debit_mandates")
}

enum DirectDebitScheme {
  BACS
  SEPA_CORE
  SEPA_B2B
}

enum DirectDebitStatus {
  PENDING
  ACTIVE
  CANCELLED
  FAILED
}

// ---------- Customer Master: Documents & notes ----------

model Document {
  id             String             @id @default(cuid())
  organisationId String
  partyId        String?
  type           String // e.g. "VAT certificate", "Signed terms"
  date           DateTime?
  expiryDate     DateTime?
  description    String?
  uploadedByUserId String?
  visibility     DocumentVisibility @default(ALL)
  url            String? // external storage reference — no file upload infra yet
  createdAt      DateTime           @default(now())

  party Party? @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("documents")
}

enum DocumentVisibility {
  ALL
  RESTRICTED
}

model Note {
  id             String   @id @default(cuid())
  partyId        String
  body           String
  pinned         Boolean  @default(false)
  restricted     Boolean  @default(false)
  authorUserId   String?
  createdAt      DateTime @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("notes")
}

// ---------- Core: audit & activity ----------

model AuditEntry {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String // e.g. "quote.approved"
  entityType     String // e.g. "Quote"
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
  @@map("audit_entries")
  workProjectId String?
  workTaskId String?
  workDocumentId String?
  workProject Project? @relation(fields:[workProjectId],references:[id])
  workTask ProjectTask? @relation(fields:[workTaskId],references:[id])
  workDocument ProjectDocument? @relation(fields:[workDocumentId],references:[id])

}

// A shared activity feed. Modules emit activities through the event bus; Home and
// record pages render them without Core knowing module-specific shapes.
model Activity {
  id             String   @id @default(cuid())
  organisationId String
  type           String // e.g. "sales_order.confirmed"
  summary        String
  entityType     String?
  entityId       String?
  // Optional link to the customer this activity relates to, independent of
  // entityType/entityId (which point at the Opportunity/Quote/Order/etc. that
  // generated it). This is what powers the unified customer Activity timeline
  // (§29) without Customer Master needing to know every module's entity shape.
  partyId        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([partyId, createdAt])
  @@map("activities")
}

// Echo is a conversation attached to one record. Notes stay with the customer,
// order or sale. Mentions point a colleague at that record.
model EchoNote {
  id             String   @id @default(cuid())
  organisationId String
  entityType     String
  entityId       String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mentions     EchoMention[]

  @@index([organisationId, entityType, entityId, createdAt])
  @@map("echo_notes")
}

model EchoMention {
  id             String    @id @default(cuid())
  organisationId String
  noteId         String
  userId         String
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  note         EchoNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([organisationId, userId, seenAt])
  @@map("echo_mentions")
}

// ---------- Core: Product Master ----------
//
// A minimal shared product catalogue — Core-owned (like Party/Customer
// Master) because Sales, future Stock, Purchasing and Manufacturing all need
// the same identity. Physical/inventory attributes belong to a future Stock
// module extending this table, not duplicating it. See
// docs/modules/SALES_ORDER_PROCESSING.md §Product relationship.

enum ProductKind {
  PRODUCT
  SERVICE
  CHARGE
}

model Product {
  qualitySpecifications QualitySpecification[]
  qualityControlPoints QualityControlPoint[]
  qualityInspections QualityInspection[]
  qualityHolds QualityHold[]
  nonConformances NonConformance[]
  financeLines FinanceDocumentLine[]
  productionPlanLines ProductionPlanLine[]
  id             String      @id @default(cuid())
  organisationId String
  categoryCode String?
  itemClass String @default("OTHER")
  code           String // SKU
  name           String
  description    String?
  kind           ProductKind @default(PRODUCT)
  unitOfMeasure  String      @default("each")
  basePriceAmount Int
  baseCurrency    String     @default("GBP")
  taxCategory     String?
  netWeightGrams Int?
  grossWeightGrams Int?
  lengthMm Int?
  widthMm Int?
  heightMm Int?
  volumeMl Int?
  unitsPerPack Int?
  packUnit String @default("")
  packsPerLayer Int?
  layersPerPallet Int?
  stackable Boolean?
  originCountry String?
  commodityCode String?
  customsDescription String?
  hazardClass String?
  unNumber String?
  trackingMode String @default("NONE")
  barcode String?
  active          Boolean    @default(true)
  /** Stock planning. 0 means not set. */
  safetyStockLevel Int @default(0)
  leadTimeDays Int @default(0)
  /** Expected usage per month. Unset means usage is read from the movement ledger. */
  monthlyUsage Int?
  averageDailyDemand Int @default(0)
  forecastMethod String @default("EXPONENTIAL_SMOOTHING")
  lastForecastDate DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerProducts CustomerProduct[]
  priceListEntries PriceListEntry[]
  agreementPrices AgreementPrice[]
  quoteLines QuoteLine[]
  orderLines       SalesOrderLine[]
  agreementLines SalesAgreementLine[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  internalMoves InternalMove[]
  stockLots StockLot[]
  stockSerials StockSerial[]
  stockPositions StockPosition[]
  definitions ProductDefinition[]
  usedIn ProductBomLine[]
  outgoingLinks ProductLink[] @relation("ProductLinkFrom")
  incomingLinks ProductLink[] @relation("ProductLinkTo")
  manufacturingOrders ManufacturingOrder[]
  manufacturingSupplySuggestions ManufacturingSupplySuggestion[]
  manufacturingDemandForecasts ManufacturingDemandForecast[]
  stockForecasts StockForecast[]

  @@unique([organisationId, code])
  @@unique([organisationId, barcode])
  @@index([organisationId, active])
  @@map("products")
}

// One active recipe per product. Older versions stay so a later edit does not rewrite history.
model ProductDefinition {
 id String @id @default(cuid())
 organisationId String
 productId String
 version Int
 status String
 supply String
 batchQuantity Decimal @db.Decimal(18,6)
 yieldPercent Decimal @db.Decimal(8,4)
 subcontractMinorPerUnit Int @default(0)
 createdByUserId String
 createdAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
 lines ProductBomLine[]
 operations ProductOperation[]
 manufacturingOrders ManufacturingOrder[]
 @@unique([organisationId,productId,version])
 @@index([organisationId,productId,status])
 @@map("product_definitions")
}
model ProductBomLine {
 id String @id @default(cuid())
 organisationId String
 definitionId String
 componentProductId String
 quantityPerUnit Decimal @db.Decimal(18,6)
 scrapPercent Decimal @db.Decimal(8,4) @default(0)
 position Int @default(0)
 notes String @default("")
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 definition ProductDefinition @relation(fields:[definitionId],references:[id],onDelete:Cascade)
 component Product @relation(fields:[componentProductId],references:[id],onDelete:Restrict)
 @@index([organisationId,componentProductId])
 @@map("product_bom_lines")
}
model ProductOperation {
 id String @id @default(cuid())
 organisationId String
 definitionId String
 name String
 position Int @default(0)
 setupMinutes Decimal @db.Decimal(18,6) @default(0)
 runMinutesPerUnit Decimal @db.Decimal(18,6) @default(0)
 crewSize Decimal @db.Decimal(8,2) @default(1)
 machineMinorPerHour Int @default(0)
 labourMinorPerHour Int @default(0)
 logisticsMinorPerBatch Int @default(0)
 machineIncludesLabour Boolean @default(false)
 workCentre String @default("")
 workCentreId String?
 resourceId String?
 overheadMinorPerHour Int @default(0)
 machineIncludesOverhead Boolean @default(false)
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 definition ProductDefinition @relation(fields:[definitionId],references:[id],onDelete:Cascade)
 centre ManufacturingWorkCentre? @relation(fields:[workCentreId],references:[id],onDelete:SetNull)
 machine ManufacturingResource? @relation(fields:[resourceId],references:[id],onDelete:SetNull)
 @@index([organisationId,definitionId])
 @@index([organisationId,workCentreId])
 @@index([organisationId,resourceId])
 @@map("product_operations")
}

// A catalogue group. Pricing still matches Product.categoryCode to this code.
model ProductCategory {
 id String @id @default(cuid())
 organisationId String
 code String
 name String
 description String @default("")
 itemClass String @default("OTHER")
 parentId String?
 position Int @default(0)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 parent ProductCategory? @relation("ProductCategoryTree",fields:[parentId],references:[id],onDelete:SetNull)
 children ProductCategory[] @relation("ProductCategoryTree")
 @@unique([organisationId,code])
 @@index([organisationId,active])
 @@map("product_categories")
}

// A pack contains another product, or this product needs another one to work.
// The bill of materials stays the manufacturing recipe. These links are the pack and the dependency.
model ProductLink {
 id String @id @default(cuid())
 organisationId String
 productId String
 relatedProductId String
 kind String
 quantity Decimal @db.Decimal(18,6)
 notes String @default("")
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 product Product @relation("ProductLinkFrom",fields:[productId],references:[id],onDelete:Cascade)
 related Product @relation("ProductLinkTo",fields:[relatedProductId],references:[id],onDelete:Restrict)
 @@unique([organisationId,productId,relatedProductId,kind])
 @@index([organisationId,relatedProductId])
 @@map("product_links")
}

// Customer-specific product data (§15) — never a second product catalogue,
// just a relationship record layered on the canonical Product + Party.
model CustomerProduct {
  id                     String  @id @default(cuid())
  partyId                String
  productId              String
  customerProductCode    String?
  customerDescription    String?
  contractedPriceAmount  Int?
  contractedPriceCurrency String? @default("GBP")
  packQuantity           Int?
  preferredDeliveryUnit  String?

  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([partyId, productId])
  @@map("customer_products")
}

// ---------- Core: Pricing ----------
//
// A reusable, explainable pricing engine (§16) — see src/core/pricing/.
// Every resolved price states its source (contract, price list, or
// standard) rather than being a mystery calculation.

model PriceList {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  currency       String   @default("GBP")
  baseCurrency String @default("GBP")
  exchangeRate Float @default(1)
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entries      PriceListEntry[]
  customerDefaults CustomerCommercialSettings[] @relation("CustomerDefaultPriceList")
  agreements CommercialAgreement[]
  quotes Quote[]
  orders       SalesOrder[]

  @@unique([organisationId, key])
  @@map("price_lists")
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  productId   String?
  scope String @default("PRODUCT")
  method String @default("FIXED")
  categoryCode String?
  percentage Float @default(0)
  adjustmentAmount Int @default(0)
  priority Int @default(0)
  active Boolean @default(true)
  unitPriceAmount Int
  minimumQuantity Int   @default(1)
  validFrom   DateTime?
  validTo     DateTime?

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minimumQuantity])
  @@map("price_list_entries")
}

// A commercial agreement is the customer's contract: which price list applies,
// any special product prices, and the service promise. SalesAgreement remains
// the blanket call-off document and is not this record.
enum CommercialAgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

model CommercialAgreement {
  id             String                     @id @default(cuid())
  organisationId String
  partyId        String
  number         String
  name           String
  status         CommercialAgreementStatus  @default(DRAFT)
  startsOn       DateTime
  endsOn         DateTime?
  priceListId    String?
  paymentTerms   String                     @default("")
  notes          String                     @default("")
  slaName        String                     @default("")
  coverage       String                     @default("")
  responseMinutes   Int?
  resolutionMinutes Int?
  slaNotes       String                     @default("")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  priceList    PriceList?   @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  prices       AgreementPrice[]

  @@unique([organisationId, number])
  @@index([organisationId, partyId, status])
  @@map("commercial_agreements")
}

model AgreementPrice {
  id               String @id @default(cuid())
  agreementId      String
  productId        String
  unitPriceAmount  Int
  minimumQuantity  Int    @default(1)

  agreement CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([agreementId, productId, minimumQuantity])
  @@index([productId])
  @@map("agreement_prices")
}

// ---------- Sales & CRM (reference implementation) ----------
//
// See docs/modules/SALES_CRM.md for the full architecture: the
// Prospect→Opportunity→Customer journey, configurable pipelines, the
// work-prioritisation engine behind Today, stage/value history, forecast
// categories, and what's deliberately deferred (sequences, email/calendar/
// telephony integration, AI, full custom reporting).

model SalesTeam {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  managerUserId  String?
  createdAt      DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members       SalesTeamMember[]
  opportunities Opportunity[]
  salesProjects SalesProject[]
  prospects     Prospect[]

  @@map("sales_teams")
}

model SalesTeamMember {
  teamId String
  userId String

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("sales_team_members")
}

// A configurable sales process. Businesses may run several (New Business,
// Renewals, Enterprise, ...) side by side — see §38 of the brief.
model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation  Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_pipelines")
}

// Won/Lost are terminal OpportunityStatus values, not ordinary draggable
// stages (§39) — PipelineStage only models the open, in-process stages.
model PipelineStage {
  id                String   @id @default(cuid())
  pipelineId        String
  key               String
  name              String
  order             Int
  defaultProbability Int     @default(0) // 0-100
  guidance          String?
  typicalDurationDays Int?

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
  @@map("sales_pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

enum RecurringPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model LossReason {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  label          String
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_loss_reasons")
}

enum OpportunityStakeholderRole {
  DECISION_MAKER
  ECONOMIC_BUYER
  CHAMPION
  TECHNICAL_BUYER
  USER
  PROCUREMENT
  LEGAL
  INFLUENCER
  BLOCKER
  OTHER
}

// The buying committee (§42) — one contact may hold more than one role.
model OpportunityStakeholder {
  id            String                       @id @default(cuid())
  opportunityId String
  contactId     String
  roles         OpportunityStakeholderRole[]
  createdAt     DateTime                     @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, contactId])
  @@map("sales_opportunity_stakeholders")
}

enum MilestoneStatus {
  PENDING
  DONE
}

// A lightweight Deal Plan (§46) — ordered milestones, nothing more
// elaborate. Optional; most opportunities will have none.
model OpportunityMilestone {
  id            String          @id @default(cuid())
  opportunityId String
  label         String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  order         Int
  createdAt     DateTime        @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, order])
  @@map("sales_opportunity_milestones")
}

enum OpportunityChangeType {
  STAGE
  VALUE
  CLOSE_DATE
  OWNER
  FORECAST_CATEGORY
}

// Deal change history (§50) — stored at the moment of change, never
// reconstructed later. Powers stage age, close-date slippage and pipeline
// inspection.
model OpportunityChangeEvent {
  id            String                 @id @default(cuid())
  opportunityId String
  type          OpportunityChangeType
  fromValue     String?
  toValue       String?
  changedByUserId String?
  createdAt     DateTime               @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("sales_opportunity_change_events")
}

model Opportunity {
  id             String   @id @default(cuid())
  organisationId String
  partyId        String
  prospectId     String?  @unique
  name           String

  pipelineId String
  stageId    String
  status     OpportunityStatus @default(OPEN)
  stageEnteredAt DateTime @default(now())

  valueAmount          Int // minor units
  valueCurrency        String  @default("GBP")
  recurringValueAmount Int?
  recurringPeriod      RecurringPeriod?

  probability       Int? // 0-100; defaults from stage, overridable
  forecastCategory  ForecastCategory @default(PIPELINE)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  // The next-action principle (§36) — every open opportunity should have one.
  nextActionNote String?
  nextActionAt   DateTime?

  ownerUserId String
  teamId      String?
  territory   String?

  source            String?
  campaign          String?
  primaryContactId  String?
  industryId        String?
  tags              String[] @default([])

  // Freeform qualification Q&A (guided-selling playbooks are deferred — see
  // docs/modules/SALES_CRM.md — this is the honest placeholder for their
  // structured output).
  qualificationNotes Json?
  useCase            String?
  painPoint          String?

  lossReasonId String?
  lossNotes    String?
  competitor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party          Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  team           SalesTeam?    @relation(fields: [teamId], references: [id])
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [id])
  lossReason     LossReason?   @relation(fields: [lossReasonId], references: [id])
  industry       CrmIndustry?  @relation(fields: [industryId], references: [id], onDelete: SetNull)

  quotes        Quote[]
  projects      Project[]
  agreements    SalesAgreement[]
  stakeholders  OpportunityStakeholder[]
  milestones    OpportunityMilestone[]
  changeEvents  OpportunityChangeEvent[]
  activities    SalesActivity[]

  @@index([organisationId, status])
  @@index([organisationId, pipelineId, stageId])
  @@index([organisationId, ownerUserId])
  @@map("sales_opportunities")
}

model CrmIndustry {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  prospects     Prospect[]
  opportunities Opportunity[]
  salesProjects SalesProject[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("crm_industries")
}

enum ProspectLifecycleStage {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  DISQUALIFIED
  CONVERTED
}

// Someone/some organisation we may want to sell to — deliberately distinct
// from Opportunity (a genuine potential sale) and from the canonical
// Customer (Party). See §9 and docs/modules/SALES_CRM.md §Prospect boundary.
model Prospect {
  id             String   @id @default(cuid())
  organisationId String

  // Identity. partyId is set once the prospect is linked to (or created as)
  // a canonical Party — never a separate prospect-only company record once
  // that link exists.
  partyId      String?
  companyName  String
  contactFirstName String?
  contactSurname   String?
  jobTitle     String?
  email        String?
  phone        String?
  website      String?
  country      String?

  ownerUserId String?
  teamId      String?
  territory   String?

  // Origin — original source is never overwritten; see §11.
  source          String?
  sourceDetail    String?
  campaign        String?
  referrer        String?
  originalSource  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?

  lifecycleStage ProspectLifecycleStage @default(NEW)

  // Explainable scoring (§16-20) — each dimension stored independently with
  // its contributing factors, never a single opaque number.
  fitScore        Int?
  fitFactors        Json?
  engagementScore Int?
  engagementFactors Json?
  intentScore     Int?
  intentFactors     Json?
  priorityScore   Int?

  estimatedValueAmount   Int?
  estimatedValueCurrency String? @default("GBP")
  timeframe              String?
  notes                  String?

  isTargetAccount Boolean @default(false)
  accountTier     String?
  industryId      String?
  tags            String[] @default([])

  disqualifiedReason String?
  nurtureReason      String?
  nextReviewAt       DateTime?

  nextActivityAt   DateTime?
  firstContactedAt DateTime?
  lastContactedAt  DateTime?
  assignedAt       DateTime?
  convertedAt      DateTime?
  disqualifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id])
  industry     CrmIndustry? @relation(fields: [industryId], references: [id], onDelete: SetNull)
  team         SalesTeam?   @relation(fields: [teamId], references: [id])
  opportunity  Opportunity?
  activities   SalesActivity[]

  @@index([organisationId, lifecycleStage])
  @@index([organisationId, ownerUserId])
  @@index([organisationId, industryId])
  @@map("sales_prospects")
}

enum SalesActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  FOLLOW_UP
  DEMO
  SITE_VISIT
  PROPOSAL
  OTHER
}

// A unified activity log for prospecting and opportunity work (§35-36).
// Distinct from the shared Atlas Activity feed (core/activity) — that's a
// read-only rendered timeline; SalesActivity is the working record sellers
// complete/schedule against, and completing one may write an Atlas Activity
// entry for the customer-facing timeline.
model SalesActivity {
  id             String            @id @default(cuid())
  organisationId String
  type           SalesActivityType
  subject        String
  notes          String?
  ownerUserId    String

  partyId         String?
  prospectId      String?
  opportunityId   String?
  salesProjectId  String?

  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party         Party?         @relation(fields: [partyId], references: [id])
  prospect      Prospect?      @relation(fields: [prospectId], references: [id])
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id])
  salesProject  SalesProject?  @relation(fields: [salesProjectId], references: [id])

  @@index([organisationId, ownerUserId, dueAt])
  @@index([organisationId, completedAt])
  @@index([organisationId, salesProjectId])
  @@map("sales_activities")
}

// Sales Project stages (configurable per organisation, but sensible defaults)
enum SalesProjectStage {
  IDENTIFIED
  QUALIFIED
  SPECIFICATION
  ESTIMATING
  QUOTING
  NEGOTIATION
  PREFERRED
  AWARDED
  LIVE
  COMPLETED
  LOST
  CANCELLED
  DORMANT
}

// SalesProjectOrganisationRole — who plays what role in this commercial project
enum SalesProjectOrganisationRole {
  END_CLIENT
  DEVELOPER
  OWNER
  SPECIFIER
  CONSULTANT
  ARCHITECT
  ENGINEER
  MAIN_CONTRACTOR
  SUBCONTRACTOR
  DISTRIBUTOR
  MERCHANT
  BUYING_CUSTOMER
  INVOICE_CUSTOMER
  FRAMEWORK_HOLDER
  DELIVERY_RECIPIENT
  OTHER
}

// Sales Project: a commercial container for project-based selling
// Unlike internal Project (execution), this is purely commercial/CRM
model SalesProject {
  id             String              @id @default(cuid())
  organisationId String
  reference      String              // e.g. "SP-00184"
  name           String
  description    String?

  stage          SalesProjectStage   @default(IDENTIFIED)
  stageEnteredAt DateTime            @default(now())

  ownerUserId    String              // Sales owner
  teamId         String?

  // Commercial values
  potentialValueAmount   Int?        // What we're trying to win (minor units)
  potentialValueCurrency String      @default("GBP")

  quotedValueAmount      Int?        // What we've quoted
  quotedValueCurrency    String      @default("GBP")

  awardedValueAmount     Int?        // What's been awarded
  awardedValueCurrency   String      @default("GBP")

  orderedValueAmount     Int?        // What's been ordered
  orderedValueCurrency   String      @default("GBP")

  remainingValueAmount   Int?        // Still to be converted
  remainingValueCurrency String      @default("GBP")

  probability            Int?        // Forecast confidence 0-100
  expectedValueAmount    Int?        // Weighted value

  // Key dates
  targetAwardDate        DateTime?
  expectedStartDate      DateTime?
  expectedCompletionDate DateTime?

  // Next action (§29)
  nextActionNote         String?
  nextActionAt           DateTime?

  // Classification
  industryId             String?
  tags                   String[]    @default([])
  notes                  String?

  // Tracking
  lastActivityAt         DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  organisation           Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team                   SalesTeam?                @relation(fields: [teamId], references: [id])
  industry               CrmIndustry?              @relation(fields: [industryId], references: [id], onDelete: SetNull)

  // Links to commercial records
  organisations          SalesProjectOrganisation[]
  stakeholders           SalesProjectStakeholder[]
  quotes                 Quote[]
  orders                 SalesOrder[]
  activities             SalesActivity[]

  @@unique([organisationId, reference])
  @@index([organisationId, stage])
  @@index([organisationId, ownerUserId])
  @@index([organisationId, targetAwardDate])
  @@map("sales_projects")
}

// Link organisations to a sales project with role-based clarity
model SalesProjectOrganisation {
  id                String                          @id @default(cuid())
  salesProjectId    String
  partyId           String
  roles             SalesProjectOrganisationRole[]  @default([])
  isPrimary         Boolean                         @default(false)  // Primary commercial contact
  notes             String?
  createdAt         DateTime                        @default(now())

  salesProject      SalesProject   @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)
  party             Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([salesProjectId, partyId])
  @@index([salesProjectId])
  @@map("sales_project_organisations")
}

// Stakeholders: who at each organisation is involved in this project
enum SalesProjectStakeholderRole {
  DECISION_MAKER
  BUYER
  ESTIMATOR
  ENGINEER
  SPECIFIER
  COMMERCIAL_MANAGER
  QUANTITY_SURVEYOR
  SITE_MANAGER
  ACCOUNTS_PAYABLE
  INFLUENCER
  CHAMPION
  BLOCKER
  OTHER
}

model SalesProjectStakeholder {
  id                String                        @id @default(cuid())
  salesProjectId    String
  contactId         String
  roles             SalesProjectStakeholderRole[] @default([])

  // Relationship & influence
  influence         String?         // STRONG, MODERATE, WEAK
  relationshipStrength String?      // STRONG, MODERATE, WEAK
  sentiment         String?         // POSITIVE, NEUTRAL, NEGATIVE

  lastContactAt     DateTime?
  notes             String?
  createdAt         DateTime        @default(now())

  salesProject      SalesProject    @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)
  contact           Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([salesProjectId, contactId])
  @@index([salesProjectId])
  @@map("sales_project_stakeholders")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum QuoteKind {
  STANDARD
  BLANKET
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

model Quote {
  ownerUserId String?
  tags String[] @default([])
  id             String      @id @default(cuid())
  organisationId String
  pricingPartyId String?
  pricingParty Party? @relation("QuotePricingAccount",fields:[pricingPartyId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  financeInstructions String?
  deliveryInstructions String?
  partyId        String
  invoiceAssignmentId String?
  invoiceAssignment CustomerInvoiceTemplate? @relation("QuoteInvoiceTemplate", fields: [invoiceAssignmentId], references: [id], onDelete: SetNull)
  opportunityId  String?
  salesProjectId String?
  reference      String
  status         QuoteStatus @default(DRAFT)
  kind           QuoteKind   @default(STANDARD)
  revision       Int @default(1)
  customerNotes  String?
  externalReference String?
  invoiceAddressSnapshot Json?
  deliveryAddressSnapshot Json?
  priceListId String?
  priceList PriceList? @relation(fields:[priceListId],references:[id])
  paymentTermId String?
  paymentTerm PaymentTerm? @relation(fields:[paymentTermId],references:[id])
  expiryDate DateTime?
  customerPoReference String?
  netAmount Int @default(0)
  taxAmount Int @default(0)
  headerDiscountPercent Float @default(0)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  totalAmount    Int
  totalCurrency  String      @default("GBP")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party          Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  salesProject   SalesProject?  @relation(fields: [salesProjectId], references: [id])
  lines          QuoteLine[]
  salesOrder     SalesOrder?
  agreement      SalesAgreement?

  @@unique([organisationId, reference])
  @@index([organisationId, salesProjectId])
  @@map("sales_quotes")
}

// A call-off order: the full quantity and agreed price. Deliveries draw it
// down and invoice that quantity. The unreleased balance is not planning demand.
model SalesAgreement {
  id               String          @id @default(cuid())
  organisationId   String
  partyId          String
  pricingPartyId   String?
  opportunityId    String?
  quoteId          String?         @unique
  projectId        String?
  reference        String
  status           AgreementStatus @default(DRAFT)
  currency         String          @default("GBP")
  startsAt         DateTime
  endsAt           DateTime
  paymentTermId    String?
  customerPoReference String?
  notes            String?
  ownerUserId      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  pricingParty Party?       @relation("AgreementPricingAccount", fields: [pricingPartyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentTerm  PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  lines        SalesAgreementLine[]
  callOffs     SalesOrder[]

  @@unique([organisationId, reference])
  @@index([organisationId, partyId, status])
  @@map("sales_agreements")
}

model SalesAgreementLine {
  id                 String @id @default(cuid())
  agreementId        String
  lineNumber         Int
  productId          String?
  description        String
  committedQuantity  Int
  unitPriceAmount    Int
  unitOfMeasure      String @default("each")
  currency           String @default("GBP")

  agreement SalesAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  callOffs  SalesOrderLine[]

  @@unique([agreementId, lineNumber])
  @@map("sales_agreement_lines")
}

model QuoteLine {
  lineNumber Int @default(0)
  type OrderLineType @default(PRODUCT)
  optional Boolean @default(false)
  unitOfMeasure String @default("each")
  taxCategory String?
  priceSource String?
  id          String @id @default(cuid())
  quoteId     String
  productId String?
  product Product? @relation(fields:[productId],references:[id])
  discountPercent Float @default(0)
  netAmount Int @default(0)
  taxAmount Int @default(0)
  description String
  quantity    Int
  unitAmount  Int
  currency    String @default("GBP")
  invoiceWhenInStock Boolean @default(false)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("sales_quote_lines")
}

// ---------- Sales Order Processing ----------
//
// See docs/modules/SALES_ORDER_PROCESSING.md. Sales owns the commercial
// promise only (what was ordered, on what terms) — never physical stock,
// warehouse movements, accounting journals or payment allocation. Those
// belong to future Logistics/Finance modules, which this schema and the
// provider interfaces in src/core/{availability,logistics,finance}/types.ts
// are shaped to receive without restructuring Sales.

enum CommercialOrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  ON_HOLD
  CANCELLED
  CLOSED
}

enum OrderType {
  STANDARD
  PROJECT
  BLANKET
  CALL_OFF
  SAMPLE
  REPLACEMENT
  INTERNAL
}

enum OrderLineType {
  SECTION
  NOTE
  PRODUCT
  SERVICE
  CHARGE
  DISCOUNT
  TEXT
}

model SalesOrder {
  financeDocuments FinanceDocument[]
  revisions SalesOrderRevision[]
  tags String[] @default([])
  id             String                @id @default(cuid())
  organisationId String
  pricingPartyId String?
  pricingParty Party? @relation("OrderPricingAccount",fields:[pricingPartyId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  financeInstructions String?
  partyId        String
  reference      String // human-readable order number, e.g. "SO-10482"
  commercialStatus CommercialOrderStatus @default(DRAFT)
  orderType      OrderType             @default(STANDARD)
  revision       Int                   @default(1)

  // Origin — CRM retains its own history; Sales only preserves the link
  // (§4). Converting an opportunity never rewrites it into an order.
  quoteId         String? @unique
  opportunityId   String?
  projectId       String?
  salesProjectId  String?
  agreementId     String?

  ownerUserId String
  teamId      String?

  customerPoReference  String?
  contractReference    String?
  projectReference     String?
  externalReference    String?

  currency        String  @default("GBP")
  priceListId     String?
  paymentTermId   String?
  invoiceAssignmentId String?
  invoiceAssignment CustomerInvoiceTemplate? @relation("OrderInvoiceTemplate", fields: [invoiceAssignmentId], references: [id], onDelete: SetNull)
  proforma        SalesProforma?
  incoterms       String?
  deliveryTerms   String?
  allowPartialDelivery Boolean @default(true)

  orderDate            DateTime  @default(now())
  confirmationDate     DateTime?
  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  latestAcceptableDate  DateTime?
  expiryDate            DateTime?

  // Immutable snapshots taken at confirmation — later changes to the
  // customer's live address must not rewrite what this order actually
  // shipped to (§5).
  invoiceAddressSnapshot  Json?
  deliveryAddressSnapshot Json?
  orderContactId    String?
  invoiceContactId  String?
  deliveryContactId String?

  netAmount      Int @default(0)
  discountAmount Int @default(0)
  taxAmount      Int @default(0)
  grossAmount    Int @default(0)
  headerDiscountPercent Float @default(0)

  internalNotes      String?
  customerNotes      String?
  deliveryInstructions String?

  cancelledAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party         Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)
  quote         Quote?             @relation(fields: [quoteId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesProject  SalesProject?      @relation(fields: [salesProjectId], references: [id], onDelete: SetNull)
  agreement     SalesAgreement?    @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  priceList     PriceList?         @relation(fields: [priceListId], references: [id])
  paymentTerm   PaymentTerm?       @relation(fields: [paymentTermId], references: [id])

  lines         SalesOrderLine[]
  fulfilments   FulfilmentRequirement[]
  holds         OrderHold[]
  changeEvents  OrderChangeEvent[]
  approvals     OrderApproval[]

  @@unique([id, organisationId])
  @@unique([organisationId, reference])
  @@index([organisationId, commercialStatus])
  @@index([organisationId, agreementId])
  @@index([organisationId, projectId])
  @@index([organisationId, salesProjectId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String        @id @default(cuid())
  orderId       String
  lineNumber    Int
  type          OrderLineType @default(PRODUCT)

  productId             String?
  descriptionSnapshot   String
  customerProductReference String?

  orderedQuantity   Int     @default(1)
  cancelledQuantity Int     @default(0)
  unitOfMeasure     String  @default("each")

  unitPriceAmount Int
  priceSource     String? // e.g. "Northbridge 2026 Contract Price", "Standard price" — see pricing engine
  discountPercent Float?  @default(0)
  netAmount       Int
  taxCategory     String?
  taxAmount       Int     @default(0)

  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  warehousePreference   String?
  projectReference      String?
  agreementLineId       String?
  notes                 String?
  invoiceWhenInStock    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])
  agreementLine SalesAgreementLine? @relation(fields: [agreementLineId], references: [id], onDelete: SetNull)
  manufacturingOrders ManufacturingOrder[]

  @@unique([orderId, lineNumber])
  @@map("sales_order_lines")
}

enum OrderHoldType {
  CREDIT
  PRICING_APPROVAL
  CUSTOMER_REQUEST
  COMPLIANCE
  STOCK_REVIEW
  DELIVERY_ISSUE
  MANUAL
}

// Reusable order holds (§30). The commercial order may continue to exist
// while operational release is blocked — a hold never deletes or hides the
// order itself.
model OrderHold {
  id               String        @id @default(cuid())
  orderId          String
  type             OrderHoldType
  reason           String?
  blockingScope     String? // e.g. "fulfilment", "all" — free text today, no enforcement engine yet
  releaseAuthority  String?
  createdByUserId   String
  createdAt         DateTime      @default(now())
  releasedByUserId  String?
  releasedAt        DateTime?

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_holds")
}

enum OrderChangeType {
  CUSTOMER
  QUANTITY
  PRICE
  PRODUCT
  REQUESTED_DATE
  DELIVERY_ADDRESS
  REFERENCE
  STATUS
  CANCELLATION
  PRICE_OVERRIDE
}

// Amendment history for confirmed orders (§36-37) — a change is recorded,
// never silently applied. Lets a future Logistics/Finance module know when
// confirmed commercial data it already acted on has since changed.
model OrderChangeEvent {
  id              String          @id @default(cuid())
  orderId         String
  lineId          String?
  type            OrderChangeType
  fromValue       String?
  toValue         String?
  reason          String?
  changedByUserId String
  createdAt       DateTime        @default(now())

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("sales_order_change_events")
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Approval requests raised by order confirmation rules (§43) — e.g. order
// value or discount above a threshold. No configurable rule engine yet;
// thresholds are fixed in src/modules/sales/services/order-approval-rules.ts,
// documented as a known simplification.
model OrderApproval {
  revision Int @default(1)
  decisionReason String?
  id              String              @id @default(cuid())
  orderId         String
  reason          String
  status          OrderApprovalStatus @default(PENDING)
  requestedByUserId String
  requestedAt       DateTime            @default(now())
  decidedByUserId   String?
  decidedAt         DateTime?

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_approvals")
}


