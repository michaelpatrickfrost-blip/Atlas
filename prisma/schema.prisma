// ---------- Quality: QMS, inspection, holds, nonconformance ----------

model QualitySequence {
  id String @id @default(cuid())
  organisationId String
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Restrict)
  prefix String
  value Int @default(0)
  @@unique([organisationId,prefix])
  @@map("quality_sequences")
}

enum QualitySpecificationStatus {
  DRAFT
  EFFECTIVE
  SUPERSEDED
}

model QualitySpecification {
  id             String   @id @default(cuid())
  organisationId String
  productId      String
  code           String
  title          String
  revision       String
  status         QualitySpecificationStatus @default(DRAFT)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  changeReason   String?
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  characteristics QualityCharacteristic[]
  controlPoints   QualityControlPoint[]
  inspections     QualityInspection[]
  nonConformances NonConformance[]

  @@unique([organisationId, productId, code, revision])
  @@index([organisationId, productId, status])
  @@map("quality_specifications")
}

enum QualityCheckMethod {
  MEASUREMENT
  PASS_FAIL
  VISUAL
  CHECKLIST
}

model QualityCharacteristic {
  id              String   @id @default(cuid())
  organisationId  String
  specificationId String
  name            String
  method          QualityCheckMethod @default(PASS_FAIL)
  unit            String?
  target          Decimal? @db.Decimal(18, 6)
  lowerLimit      Decimal? @db.Decimal(18, 6)
  upperLimit      Decimal? @db.Decimal(18, 6)
  position        Int      @default(0)

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  specification QualitySpecification  @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  measurements  QualityMeasurement[]

  @@index([organisationId, specificationId])
  @@map("quality_characteristics")
}

enum QualityControlTrigger {
  RECEIPT
  PRODUCTION
  FINAL
  DISPATCH
  RETURN
  MANUAL
}

model QualityControlPoint {
  id              String   @id @default(cuid())
  organisationId  String
  code            String
  name            String
  productId       String?
  operation       String?
  trigger         QualityControlTrigger @default(MANUAL)
  specificationId String?
  sampleSize      Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  specification QualitySpecification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)
  inspections   QualityInspection[]

  @@unique([organisationId, code])
  @@index([organisationId, productId, active])
  @@map("quality_control_points")
}

enum QualityInspectionResult {
  PENDING
  PASS
  FAIL
}

model QualityInspection {
  id                String   @id @default(cuid())
  organisationId    String
  number            String
  controlPointId    String
  specificationId   String?
  productId         String
  lotCode           String?
  warehouseId       String?
  locationId        String?
  sourceType        String?
  sourceId          String?
  quantityInspected Int      @default(1)
  result            QualityInspectionResult @default(PENDING)
  notes             String?
  inspectedByUserId String
  inspectedAt       DateTime @default(now())

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  controlPoint  QualityControlPoint   @relation(fields: [controlPointId], references: [id], onDelete: Restrict)
  specification QualitySpecification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  measurements  QualityMeasurement[]
  holds         QualityHold[]
  nonConformances NonConformance[]

  @@unique([organisationId, number])
  @@index([organisationId, productId, result])
  @@index([organisationId, controlPointId])
  @@map("quality_inspections")
}

model QualityMeasurement {
  id              String   @id @default(cuid())
  organisationId  String
  inspectionId    String
  characteristicId String?
  sampleIndex     Int      @default(1)
  valueText       String?
  valueNumber     Decimal? @db.Decimal(18, 6)
  pass            Boolean  @default(true)

  organisation  Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  inspection    QualityInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  characteristic QualityCharacteristic? @relation(fields: [characteristicId], references: [id], onDelete: SetNull)

  @@index([organisationId, inspectionId])
  @@map("quality_measurements")
}

enum QualityHoldStatus {
  ACTIVE
  RELEASED
}

model QualityHold {
  id              String   @id @default(cuid())
  organisationId  String
  number          String
  productId       String
  lotCode         String?
  warehouseId     String?
  locationId      String?
  quantity        Int
  status          QualityHoldStatus @default(ACTIVE)
  reason          String
  inspectionId    String?
  placedByUserId  String
  placedAt        DateTime @default(now())
  releasedByUserId String?
  releasedAt      DateTime?
  releaseNote     String?

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  inspection   QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  nonConformances NonConformance[]

  @@unique([organisationId, number])
  @@index([organisationId, productId, status])
  @@map("quality_holds")
}

enum NonConformanceSource {
  INCOMING
  MANUFACTURING
  FINAL
  WAREHOUSE
  CUSTOMER
  SUPPLIER
  AUDIT
  OTHER
}

enum NonConformanceSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NonConformanceStatus {
  OPEN
  CONTAINED
  INVESTIGATING
  DISPOSITIONED
  CLOSED
}

enum NonConformanceDisposition {
  PENDING
  USE_AS_IS
  REWORK
  SCRAP
  RETURN_TO_SUPPLIER
  CONCESSION
  SORT
}

model NonConformance {
  id                 String   @id @default(cuid())
  organisationId     String
  number             String
  title              String
  source             NonConformanceSource
  status             NonConformanceStatus @default(OPEN)
  severity           NonConformanceSeverity @default(MINOR)
  productId          String?
  partyId            String?
  specificationId    String?
  inspectionId       String?
  holdId             String?
  quantityAffected   Int?
  defect             String
  containment        String?
  disposition        NonConformanceDisposition @default(PENDING)
  dispositionNote    String?
  rootCause          String?
  rootCauseConfirmed Boolean  @default(false)
  reportedByUserId   String
  reportedAt         DateTime @default(now())
  closedByUserId     String?
  closedAt           DateTime?
  version            Int      @default(1)

  organisation  Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  product       Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  specification QualitySpecification?   @relation(fields: [specificationId], references: [id], onDelete: SetNull)
  inspection    QualityInspection?      @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  hold          QualityHold?            @relation(fields: [holdId], references: [id], onDelete: SetNull)
  actions       NonConformanceAction[]

  @@unique([organisationId, number])
  @@index([organisationId, status, severity])
  @@index([organisationId, productId])
  @@map("non_conformances")
}

enum NonConformanceActionStatus {
  OPEN
  DONE
  VERIFIED
  INEFFECTIVE
}

model NonConformanceAction {
  id              String   @id @default(cuid())
  organisationId  String
  ncrId           String
  description     String
  ownerUserId     String
  dueDate         DateTime?
  status          NonConformanceActionStatus @default(OPEN)
  effectivenessCriterion   String?
  effectivenessReviewDate  DateTime?
  effectivenessResult      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ncr          NonConformance @relation(fields: [ncrId], references: [id], onDelete: Cascade)

  @@index([organisationId, ncrId])
  @@map("non_conformance_actions")
}

