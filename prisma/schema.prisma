// Team planner. Holidays stay on HR absence records. This module owns the
// team list, shared tasks, cover, handovers, whereabouts and team moments.
model PlannerTeam {
  id               String   @id @default(cuid())
  organisationId   String
  name             String
  createdByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      PlannerTeamMember[]
  tasks        PlannerTask[]
  covers       PlannerCover[]
  handovers    PlannerHandover[]
  places       PlannerPlace[]
  moments      PlannerMoment[]

  @@index([organisationId])
  @@map("planner_teams")
}

model PlannerTeamMember {
  id             String   @id @default(cuid())
  organisationId String
  teamId         String
  employeeId     String
  lead           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team         PlannerTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([organisationId, employeeId])
  @@map("planner_team_members")
}

enum PlannerTaskStatus {
  OPEN
  DOING
  DONE
}

model PlannerTask {
  id                 String            @id @default(cuid())
  organisationId     String
  teamId             String
  title              String
  detail             String?
  assigneeEmployeeId String?
  dueOn              DateTime?         @db.Date
  status             PlannerTaskStatus @default(OPEN)
  createdByUserId    String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team         PlannerTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee     Employee?    @relation(fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)

  @@index([organisationId, teamId, status])
  @@index([organisationId, assigneeEmployeeId])
  @@map("planner_tasks")
}

model PlannerCover {
  id              String    @id @default(cuid())
  organisationId  String
  teamId          String
  employeeId      String
  coverEmployeeId String
  startsOn        DateTime  @db.Date
  endsOn          DateTime  @db.Date
  note            String?
  createdAt       DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team         PlannerTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("PlannerCoverAway", fields: [employeeId], references: [id], onDelete: Cascade)
  cover        Employee     @relation("PlannerCoverFor", fields: [coverEmployeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, teamId, startsOn])
  @@map("planner_covers")
}

model PlannerHandover {
  id             String   @id @default(cuid())
