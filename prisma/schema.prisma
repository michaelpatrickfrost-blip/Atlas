// Atlas core data model.
// Core owns platform concerns (org, users, auth, permissions, audit, activity).
// Modules own business entities but share Party/Organisation/Currency concepts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Core: tenancy & identity ----------

model Organisation {
  salesPolicy Json @default("{}")
  outboxEvents DomainOutbox[]
  allowProductCreation Boolean @default(true)
  allowCustomerCreation Boolean @default(true)
  quotationTemplates SalesQuotationTemplate[]
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status String @default("ACTIVE")
  subscriptionStatus String @default("TRIAL")
  trialEndsAt DateTime?
  planName String @default("All apps trial")

  memberships  Membership[]
  moduleStates ModuleState[]
  projects Project[]
  chatMessages ChatMessage[]
  dashboards Dashboard[]
  warehouses Warehouse[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  kpis Kpi[]
  projectTasks ProjectTask[]
  meetings Meeting[]
  parties      Party[]
  auditEntries AuditEntry[]
  activities   Activity[]

  // Sales module entities (tenant-scoped)
  opportunities Opportunity[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  prospects       Prospect[]
  pipelines       Pipeline[]
  salesTeams      SalesTeam[]
  lossReasons     LossReason[]
  salesActivities SalesActivity[]
  products        Product[]
  priceLists      PriceList[]

  @@map("organisations")
  salesSavedViews SalesSavedView[]
  salesWorkingDrafts SalesWorkingDraft[]

  employees Employee[]
  employeeTasks EmployeeTask[]
  appraisals Appraisal[]
  oneToOnes OneToOne[]
  absenceRecords AbsenceRecord[]
  rotaShifts RotaShift[]
  payrollRuns PayrollRun[]
  payslips Payslip[]
  customerTradingLinks CustomerTradingLink[]

}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  platformAdmin PlatformAdministrator?
  memberships Membership[]
  employeeProfiles Employee[]

  @@map("users")
}

// A user's membership of an org, carrying the roles that grant capabilities.
model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  active Boolean @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        RoleOnMembership[]

  @@unique([organisationId, userId])
  @@map("memberships")
}

// A role bundles capability strings. Roles are org-scoped so an org can customise them,
// but modules/seed data create a standard set per org on creation.
model Role {
  id             String   @id @default(cuid())
  organisationId String
  key            String // e.g. "admin", "sales_manager"
  name           String
  capabilities   String[] // e.g. ["sales.quote.read", "sales.quote.approve"]
  createdAt      DateTime @default(now())

  memberships RoleOnMembership[]

  @@unique([organisationId, key])
  @@map("roles")
}

model RoleOnMembership {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("roles_on_memberships")
}

// ---------- Core: module registry ----------

// Persisted enable/disable state per org. The module catalogue itself (manifest,
// capabilities, nav, routes) lives in code — see src/modules/registry.ts.
model ModuleState {
  id             String   @id @default(cuid())
  organisationId String
  moduleId       String
  enabled        Boolean  @default(false)
  entitled Boolean @default(false)
  installedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleId])
  @@map("module_states")
}

// ---------- Core: Customer Master (canonical Party + extensions) ----------
//
// A Party is any real-world actor a business deals with: a company or a person.
// Modules attach their own records (Opportunity, Quote, Invoice, Ticket, ...) to a
// Party rather than each inventing their own "Customer" copy — see docs/CUSTOMER_MASTER.md
// for the full architecture (one identity, module-contributed Overview sections,
// capability-gated sensitive data, duplicate detection, multi-company deferral).
//
// Identity lives on Party itself. Commercial/credit configuration is split into
// their own 1:1 tables so each is independently section-editable (never one giant
// edit form) and so a future multi-company override can attach per-company rows
// without touching identity.
model CustomerTradingLink {
  id String @id @default(cuid())
  organisationId String
  accountId String
  tradingAccountId String
  active Boolean @default(true)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  account Party @relation("TradingSource",fields:[accountId],references:[id],onDelete:Cascade)
  tradingAccount Party @relation("TradingTarget",fields:[tradingAccountId],references:[id],onDelete:Cascade)
  @@unique([organisationId,accountId,tradingAccountId])
  @@index([organisationId,tradingAccountId,active])
  @@map("customer_trading_links")
}

model Party {
  id             String         @id @default(cuid())
  organisationId String
  kind           PartyKind
  name           String // legal name
  tradingName    String?
  customerCode   String // e.g. "C000184", unique per org, assigned at creation
  status         CustomerStatus @default(PROSPECT)
  hierarchyRole String @default("CUSTOMER")
  customerGroup  String?
  parentPartyId  String?

  website                String?
  industry               String?
  registrationNumber     String?
  countryOfRegistration  String?
  relationshipStartDate  DateTime?
  accountManagerUserId   String? // soft reference to User.id — see docs/CUSTOMER_MASTER.md
  territory              String?
  tags                   String[]
  preferredLanguage      String?
  preferredCurrency      String  @default("GBP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       Party?       @relation("PartyHierarchy", fields: [parentPartyId], references: [id])
  children     Party[]      @relation("PartyHierarchy")
  projects Project[]

  contacts                 Contact[]
  addresses                Address[]
  communicationDestinations CommunicationDestination[]
  taxRegistrations         TaxRegistration[]
  bankAccounts             BankAccount[]
  directDebitMandates      DirectDebitMandate[]
  documents                Document[]
  notes                    Note[]
  commercialSettings       CustomerCommercialSettings?
  creditProfile            CustomerCreditProfile?
  activities               Activity[]

  opportunities Opportunity[]
  quotes        Quote[]
  salesOrders   SalesOrder[]
  prospects       Prospect[]
  salesActivities SalesActivity[]
  customerProducts CustomerProduct[]

  @@unique([organisationId, customerCode])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("parties")
  tradingLinks CustomerTradingLink[] @relation("TradingSource")
  suppliedForAccounts CustomerTradingLink[] @relation("TradingTarget")
  pricedQuotes Quote[] @relation("QuotePricingAccount")
  pricedOrders SalesOrder[] @relation("OrderPricingAccount")

}

enum PartyKind {
  COMPANY
  PERSON
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  INACTIVE
  CLOSED
}

// A person associated with a Party. One person, many roles — never duplicated
// per function (§9).
model Contact {
  id             String        @id @default(cuid())
  partyId        String
  title          String?
  firstName      String
  middleName     String?
  surname        String
  preferredName  String?
  jobTitle       String?
  department     String?
  email          String?
  alternativeEmail String?
  phone          String?
  mobile         String?
  preferredContactMethod ContactPreferredMethod?
  language       String?
  notes          String?
  status         ContactStatus @default(ACTIVE)
  isPrimary      Boolean       @default(false)
  roles          ContactRole[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  party                     Party                      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  communicationDestinations CommunicationDestination[]
  addresses                 Address[]
  opportunityStakeholders   OpportunityStakeholder[]
  opportunitiesAsPrimaryContact Opportunity[]

  @@index([partyId])
  @@map("contacts")
}

enum ContactPreferredMethod {
  EMAIL
  PHONE
  MOBILE
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactRole {
  PRIMARY
  SALES
  ACCOUNTS_PAYABLE
  PURCHASING
  OPERATIONS
  DELIVERY
  TECHNICAL
  EXECUTIVE
  OTHER
}

// Which contact/email a given document type goes to — not every document goes
// to the same inbox (§10). Falls back to the contact marked primary when unset.
model CommunicationDestination {
  id        String                 @id @default(cuid())
  partyId   String
  purpose   CommunicationPurpose
  contactId String?
  email     String?
  createdAt DateTime               @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId, purpose])
  @@map("communication_destinations")
}

enum CommunicationPurpose {
  ORDERS
  INVOICES
  STATEMENTS
  CREDIT_CONTROL
  DELIVERY
}

model Address {
  id        String      @id @default(cuid())
  partyId   String
  type      AddressType @default(OTHER)
  label     String?
  locationName String?
  line1     String
  line2     String?
  city      String?
  region    String?
  postcode  String?
  country   String?
  telephone String?
  contactId String?
  deliveryInstructions String?
  active    Boolean     @default(true)
  isDefaultBilling  Boolean @default(false)
  isDefaultDelivery Boolean @default(false)
  createdAt DateTime    @default(now())

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([partyId])
  @@map("addresses")
}

enum AddressType {
  REGISTERED
  BILLING
  DELIVERY
  SITE
  SERVICE
  OFFICE
  OTHER
}

// ---------- Customer Master: Commercial ----------

model CustomerCommercialSettings {
  partyId String @id

  secondaryAccountManagerUserId String?
  customerSegment                String?
  priceList                      String?
  defaultPriceList PriceList? @relation("CustomerDefaultPriceList", fields: [priceList], references: [id], onDelete: SetNull)
  discountGroup                  String?
  pricingAgreementReference      String?

  customerPoRequired       Boolean @default(false)
  poFormatRules             String?
  orderReferenceRequired    Boolean @default(false)
  partialShipmentAllowed    Boolean @default(true)
  backordersAllowed         Boolean @default(true)

  defaultDeliveryAddressId String?
  deliveryMethod            String?
  shippingTerms              String?
  preferredWarehouse         String?
  shippingAccountReference   String?

  quoteTemplate                  String?
  orderConfirmationPreference    String?
  invoiceDeliveryPreference      String?

  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("customer_commercial_settings")
}

// ---------- Customer Master: Credit & payment ----------

model PaymentTerm {
  id             String          @id @default(cuid())
  organisationId String
  key            String
  name           String
  days           Int?
  type           PaymentTermType @default(NET)
  createdAt      DateTime        @default(now())

  creditProfiles CustomerCreditProfile[]
  quotes Quote[]
  salesOrders    SalesOrder[]

  @@unique([organisationId, key])
  @@map("payment_terms")
}

enum PaymentTermType {
  DUE_ON_RECEIPT
  NET
  END_OF_MONTH
  CUSTOM
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CARD
  CASH
  CHEQUE
  ACCOUNT
  OTHER
}

// Customer-level credit configuration. Calculated exposure (open invoices + open
// orders) is NOT stored here — it's supplied by Finance/Sales through their own
// queries, never duplicated into Customer Master (§16).
model CustomerCreditProfile {
  partyId String @id

  creditLimitAmount   Int     @default(0)
  creditLimitCurrency String  @default("GBP")
  onHold              Boolean @default(false)
  holdReason          String?
  holdDate            DateTime?
  holdSetByUserId     String?
  reviewDate          DateTime?
  riskRating          String?
  insuranceLimitAmount Int?
  collectionsStatus   String?
  statementFrequency  String?
  reminderPolicy      String?
  paymentTermId       String?
  paymentMethod       PaymentMethod?

  updatedAt DateTime @updatedAt

  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  @@map("customer_credit_profiles")
}

// ---------- Customer Master: Tax ----------

// A customer may hold several tax registrations across jurisdictions. Format
// validation and external verification are tracked separately (§19–20) — Atlas
// never claims a number is verified unless a real check (manual or service) was
// actually recorded.
model TaxRegistration {
  id                 String               @id @default(cuid())
  partyId            String
  jurisdiction       String // ISO country/region code, e.g. "GB", "XI"
  registrationType   String // e.g. "VAT", "GST"
  number             String
  normalizedNumber   String // whitespace/case-normalised, used for matching/search
  effectiveDate      DateTime?
  expiryDate         DateTime?
  validationStatus   TaxValidationStatus @default(NOT_VERIFIED)
  validationDate     DateTime?
  validationSource   String? // "manual" today; a future service name once integrated
  verifiedLegalName  String?
  verifiedAddress    String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([normalizedNumber])
  @@map("tax_registrations")
}

enum TaxValidationStatus {
  NOT_VERIFIED
  MANUALLY_VERIFIED
  VERIFIED_BY_SERVICE
  FAILED
}

// ---------- Customer Master: Bank & Direct Debit ----------
//
// Sensitive. Raw values are stored (this environment has no KMS/secrets
// infrastructure to encrypt at rest — see docs/CUSTOMER_MASTER.md §Security for
// the honest limitation and what a production deployment must add). Every read
// path masks by default; only a capability-gated, audited reveal action returns
// the full value. Never included in global search results or bulk exports.
model BankAccount {
  id             String                 @id @default(cuid())
  partyId        String
  accountHolder  String
  bankName       String?
  label          String?
  country        String
  currency       String
  sortCode       String?
  accountNumber  String?
  iban           String?
  bic            String?
  purpose        BankAccountPurpose     @default(OTHER)
  active         Boolean                @default(true)
  isDefault      Boolean                @default(false)
  verifiedStatus BankVerificationStatus @default(NOT_VERIFIED)
  verifiedDate   DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  party           Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  directDebitMandates DirectDebitMandate[]

  @@index([partyId])
  @@map("bank_accounts")
}

enum BankAccountPurpose {
  DIRECT_DEBIT
  REFUND
  REMITTANCE
  OTHER
}

enum BankVerificationStatus {
  NOT_VERIFIED
  VERIFIED
}

model DirectDebitMandate {
  id                 String               @id @default(cuid())
  partyId            String
  bankAccountId      String
  scheme             DirectDebitScheme
  mandateReference   String
  status             DirectDebitStatus    @default(PENDING)
  agreedDate         DateTime?
  effectiveDate      DateTime?
  firstCollectionDate DateTime?
  lastCollectionDate DateTime?
  cancellationDate   DateTime?
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  party       Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([partyId, mandateReference])
  @@map("direct_debit_mandates")
}

enum DirectDebitScheme {
  BACS
  SEPA_CORE
  SEPA_B2B
}

enum DirectDebitStatus {
  PENDING
  ACTIVE
  CANCELLED
  FAILED
}

// ---------- Customer Master: Documents & notes ----------

model Document {
  id             String             @id @default(cuid())
  organisationId String
  partyId        String?
  type           String // e.g. "VAT certificate", "Signed terms"
  date           DateTime?
  expiryDate     DateTime?
  description    String?
  uploadedByUserId String?
  visibility     DocumentVisibility @default(ALL)
  url            String? // external storage reference — no file upload infra yet
  createdAt      DateTime           @default(now())

  party Party? @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("documents")
}

enum DocumentVisibility {
  ALL
  RESTRICTED
}

model Note {
  id             String   @id @default(cuid())
  partyId        String
  body           String
  pinned         Boolean  @default(false)
  restricted     Boolean  @default(false)
  authorUserId   String?
  createdAt      DateTime @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("notes")
}

// ---------- Core: audit & activity ----------

model AuditEntry {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String // e.g. "quote.approved"
  entityType     String // e.g. "Quote"
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
  @@map("audit_entries")
}

// A shared activity feed. Modules emit activities through the event bus; Home and
// record pages render them without Core knowing module-specific shapes.
model Activity {
  id             String   @id @default(cuid())
  organisationId String
  type           String // e.g. "sales_order.confirmed"
  summary        String
  entityType     String?
  entityId       String?
  // Optional link to the customer this activity relates to, independent of
  // entityType/entityId (which point at the Opportunity/Quote/Order/etc. that
  // generated it). This is what powers the unified customer Activity timeline
  // (§29) without Customer Master needing to know every module's entity shape.
  partyId        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([partyId, createdAt])
  @@map("activities")
}

// ---------- Core: Product Master ----------
//
// A minimal shared product catalogue — Core-owned (like Party/Customer
// Master) because Sales, future Stock, Purchasing and Manufacturing all need
// the same identity. Physical/inventory attributes belong to a future Stock
// module extending this table, not duplicating it. See
// docs/modules/SALES_ORDER_PROCESSING.md §Product relationship.

enum ProductKind {
  PRODUCT
  SERVICE
  CHARGE
}

model Product {
  id             String      @id @default(cuid())
  organisationId String
  categoryCode String?
  code           String // SKU
  name           String
  description    String?
  kind           ProductKind @default(PRODUCT)
  unitOfMeasure  String      @default("each")
  basePriceAmount Int
  baseCurrency    String     @default("GBP")
  taxCategory     String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerProducts CustomerProduct[]
  priceListEntries PriceListEntry[]
  quoteLines QuoteLine[]
  orderLines       SalesOrderLine[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([organisationId, code])
  @@index([organisationId, active])
  @@map("products")
}

// Customer-specific product data (§15) — never a second product catalogue,
// just a relationship record layered on the canonical Product + Party.
model CustomerProduct {
  id                     String  @id @default(cuid())
  partyId                String
  productId              String
  customerProductCode    String?
  customerDescription    String?
  contractedPriceAmount  Int?
  contractedPriceCurrency String? @default("GBP")
  packQuantity           Int?
  preferredDeliveryUnit  String?

  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([partyId, productId])
  @@map("customer_products")
}

// ---------- Core: Pricing ----------
//
// A reusable, explainable pricing engine (§16) — see src/core/pricing/.
// Every resolved price states its source (contract, price list, or
// standard) rather than being a mystery calculation.

model PriceList {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  currency       String   @default("GBP")
  baseCurrency String @default("GBP")
  exchangeRate Float @default(1)
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entries      PriceListEntry[]
  customerDefaults CustomerCommercialSettings[] @relation("CustomerDefaultPriceList")
  quotes Quote[]
  orders       SalesOrder[]

  @@unique([organisationId, key])
  @@map("price_lists")
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String
  productId   String?
  scope String @default("PRODUCT")
  method String @default("FIXED")
  categoryCode String?
  percentage Float @default(0)
  adjustmentAmount Int @default(0)
  priority Int @default(0)
  active Boolean @default(true)
  unitPriceAmount Int
  minimumQuantity Int   @default(1)
  validFrom   DateTime?
  validTo     DateTime?

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, minimumQuantity])
  @@map("price_list_entries")
}

// ---------- Sales & CRM (reference implementation) ----------
//
// See docs/modules/SALES_CRM.md for the full architecture: the
// Prospect→Opportunity→Customer journey, configurable pipelines, the
// work-prioritisation engine behind Today, stage/value history, forecast
// categories, and what's deliberately deferred (sequences, email/calendar/
// telephony integration, AI, full custom reporting).

model SalesTeam {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  managerUserId  String?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      SalesTeamMember[]
  opportunities Opportunity[]
  prospects     Prospect[]

  @@map("sales_teams")
}

model SalesTeamMember {
  teamId String
  userId String

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("sales_team_members")
}

// A configurable sales process. Businesses may run several (New Business,
// Renewals, Enterprise, ...) side by side — see §38 of the brief.
model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation  Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_pipelines")
}

// Won/Lost are terminal OpportunityStatus values, not ordinary draggable
// stages (§39) — PipelineStage only models the open, in-process stages.
model PipelineStage {
  id                String   @id @default(cuid())
  pipelineId        String
  key               String
  name              String
  order             Int
  defaultProbability Int     @default(0) // 0-100
  guidance          String?
  typicalDurationDays Int?

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
  @@map("sales_pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

enum RecurringPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model LossReason {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  label          String
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organisationId, key])
  @@map("sales_loss_reasons")
}

enum OpportunityStakeholderRole {
  DECISION_MAKER
  ECONOMIC_BUYER
  CHAMPION
  TECHNICAL_BUYER
  USER
  PROCUREMENT
  LEGAL
  INFLUENCER
  BLOCKER
  OTHER
}

// The buying committee (§42) — one contact may hold more than one role.
model OpportunityStakeholder {
  id            String                       @id @default(cuid())
  opportunityId String
  contactId     String
  roles         OpportunityStakeholderRole[]
  createdAt     DateTime                     @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, contactId])
  @@map("sales_opportunity_stakeholders")
}

enum MilestoneStatus {
  PENDING
  DONE
}

// A lightweight Deal Plan (§46) — ordered milestones, nothing more
// elaborate. Optional; most opportunities will have none.
model OpportunityMilestone {
  id            String          @id @default(cuid())
  opportunityId String
  label         String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  order         Int
  createdAt     DateTime        @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, order])
  @@map("sales_opportunity_milestones")
}

enum OpportunityChangeType {
  STAGE
  VALUE
  CLOSE_DATE
  OWNER
  FORECAST_CATEGORY
}

// Deal change history (§50) — stored at the moment of change, never
// reconstructed later. Powers stage age, close-date slippage and pipeline
// inspection.
model OpportunityChangeEvent {
  id            String                 @id @default(cuid())
  opportunityId String
  type          OpportunityChangeType
  fromValue     String?
  toValue       String?
  changedByUserId String?
  createdAt     DateTime               @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("sales_opportunity_change_events")
}

model Opportunity {
  id             String   @id @default(cuid())
  organisationId String
  partyId        String
  prospectId     String?  @unique
  name           String

  pipelineId String
  stageId    String
  status     OpportunityStatus @default(OPEN)
  stageEnteredAt DateTime @default(now())

  valueAmount          Int // minor units
  valueCurrency        String  @default("GBP")
  recurringValueAmount Int?
  recurringPeriod      RecurringPeriod?

  probability       Int? // 0-100; defaults from stage, overridable
  forecastCategory  ForecastCategory @default(PIPELINE)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?

  // The next-action principle (§36) — every open opportunity should have one.
  nextActionNote String?
  nextActionAt   DateTime?

  ownerUserId String
  teamId      String?
  territory   String?

  source            String?
  campaign          String?
  primaryContactId  String?

  // Freeform qualification Q&A (guided-selling playbooks are deferred — see
  // docs/modules/SALES_CRM.md — this is the honest placeholder for their
  // structured output).
  qualificationNotes Json?
  useCase            String?
  painPoint          String?

  lossReasonId String?
  lossNotes    String?
  competitor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party          Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  team           SalesTeam?    @relation(fields: [teamId], references: [id])
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [id])
  lossReason     LossReason?   @relation(fields: [lossReasonId], references: [id])

  quotes        Quote[]
  stakeholders  OpportunityStakeholder[]
  milestones    OpportunityMilestone[]
  changeEvents  OpportunityChangeEvent[]
  activities    SalesActivity[]

  @@index([organisationId, status])
  @@index([organisationId, pipelineId, stageId])
  @@index([organisationId, ownerUserId])
  @@map("sales_opportunities")
}

enum ProspectLifecycleStage {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  DISQUALIFIED
  CONVERTED
}

// Someone/some organisation we may want to sell to — deliberately distinct
// from Opportunity (a genuine potential sale) and from the canonical
// Customer (Party). See §9 and docs/modules/SALES_CRM.md §Prospect boundary.
model Prospect {
  id             String   @id @default(cuid())
  organisationId String

  // Identity. partyId is set once the prospect is linked to (or created as)
  // a canonical Party — never a separate prospect-only company record once
  // that link exists.
  partyId      String?
  companyName  String
  contactFirstName String?
  contactSurname   String?
  jobTitle     String?
  email        String?
  phone        String?
  website      String?
  country      String?

  ownerUserId String?
  teamId      String?
  territory   String?

  // Origin — original source is never overwritten; see §11.
  source          String?
  sourceDetail    String?
  campaign        String?
  referrer        String?
  originalSource  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?

  lifecycleStage ProspectLifecycleStage @default(NEW)

  // Explainable scoring (§16-20) — each dimension stored independently with
  // its contributing factors, never a single opaque number.
  fitScore        Int?
  fitFactors        Json?
  engagementScore Int?
  engagementFactors Json?
  intentScore     Int?
  intentFactors     Json?
  priorityScore   Int?

  estimatedValueAmount   Int?
  estimatedValueCurrency String? @default("GBP")
  timeframe              String?
  notes                  String?

  isTargetAccount Boolean @default(false)
  accountTier     String?

  disqualifiedReason String?
  nurtureReason      String?
  nextReviewAt       DateTime?

  nextActivityAt   DateTime?
  firstContactedAt DateTime?
  lastContactedAt  DateTime?
  assignedAt       DateTime?
  convertedAt      DateTime?
  disqualifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id])
  team         SalesTeam?   @relation(fields: [teamId], references: [id])
  opportunity  Opportunity?
  activities   SalesActivity[]

  @@index([organisationId, lifecycleStage])
  @@index([organisationId, ownerUserId])
  @@map("sales_prospects")
}

enum SalesActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  FOLLOW_UP
  DEMO
  SITE_VISIT
  PROPOSAL
  OTHER
}

// A unified activity log for prospecting and opportunity work (§35-36).
// Distinct from the shared Atlas Activity feed (core/activity) — that's a
// read-only rendered timeline; SalesActivity is the working record sellers
// complete/schedule against, and completing one may write an Atlas Activity
// entry for the customer-facing timeline.
model SalesActivity {
  id             String            @id @default(cuid())
  organisationId String
  type           SalesActivityType
  subject        String
  notes          String?
  ownerUserId    String

  partyId       String?
  prospectId    String?
  opportunityId String?

  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party?       @relation(fields: [partyId], references: [id])
  prospect     Prospect?    @relation(fields: [prospectId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([organisationId, ownerUserId, dueAt])
  @@index([organisationId, completedAt])
  @@map("sales_activities")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  ownerUserId String?
  tags String[] @default([])
  id             String      @id @default(cuid())
  organisationId String
  pricingPartyId String?
  pricingParty Party? @relation("QuotePricingAccount",fields:[pricingPartyId],references:[id])
  financeInstructions String?
  deliveryInstructions String?
  partyId        String
  opportunityId  String?
  reference      String
  status         QuoteStatus @default(DRAFT)
  revision       Int @default(1)
  customerNotes  String?
  externalReference String?
  invoiceAddressSnapshot Json?
  deliveryAddressSnapshot Json?
  priceListId String?
  priceList PriceList? @relation(fields:[priceListId],references:[id])
  paymentTermId String?
  paymentTerm PaymentTerm? @relation(fields:[paymentTermId],references:[id])
  expiryDate DateTime?
  customerPoReference String?
  netAmount Int @default(0)
  taxAmount Int @default(0)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  totalAmount    Int
  totalCurrency  String      @default("GBP")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])
  lines        QuoteLine[]
  salesOrder   SalesOrder?

  @@unique([organisationId, reference])
  @@map("sales_quotes")
}

model QuoteLine {
  lineNumber Int @default(0)
  type OrderLineType @default(PRODUCT)
  optional Boolean @default(false)
  unitOfMeasure String @default("each")
  taxCategory String?
  priceSource String?
  id          String @id @default(cuid())
  quoteId     String
  productId String?
  product Product? @relation(fields:[productId],references:[id])
  discountPercent Float @default(0)
  netAmount Int @default(0)
  taxAmount Int @default(0)
  description String
  quantity    Int
  unitAmount  Int
  currency    String @default("GBP")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("sales_quote_lines")
}

// ---------- Sales Order Processing ----------
//
// See docs/modules/SALES_ORDER_PROCESSING.md. Sales owns the commercial
// promise only (what was ordered, on what terms) — never physical stock,
// warehouse movements, accounting journals or payment allocation. Those
// belong to future Logistics/Finance modules, which this schema and the
// provider interfaces in src/core/{availability,logistics,finance}/types.ts
// are shaped to receive without restructuring Sales.

enum CommercialOrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  ON_HOLD
  CANCELLED
  CLOSED
}

enum OrderType {
  STANDARD
  PROJECT
  BLANKET
  CALL_OFF
  SAMPLE
  REPLACEMENT
  INTERNAL
}

enum OrderLineType {
  SECTION
  NOTE
  PRODUCT
  SERVICE
  CHARGE
  DISCOUNT
  TEXT
}

model SalesOrder {
  revisions SalesOrderRevision[]
  tags String[] @default([])
  id             String                @id @default(cuid())
  organisationId String
  pricingPartyId String?
  pricingParty Party? @relation("OrderPricingAccount",fields:[pricingPartyId],references:[id])
  financeInstructions String?
  partyId        String
  reference      String // human-readable order number, e.g. "SO-10482"
  commercialStatus CommercialOrderStatus @default(DRAFT)
  orderType      OrderType             @default(STANDARD)
  revision       Int                   @default(1)

  // Origin — CRM retains its own history; Sales only preserves the link
  // (§4). Converting an opportunity never rewrites it into an order.
  quoteId       String? @unique
  opportunityId String?

  ownerUserId String
  teamId      String?

  customerPoReference  String?
  contractReference    String?
  projectReference     String?
  externalReference    String?

  currency        String  @default("GBP")
  priceListId     String?
  paymentTermId   String?
  incoterms       String?
  deliveryTerms   String?
  allowPartialDelivery Boolean @default(true)

  orderDate            DateTime  @default(now())
  confirmationDate     DateTime?
  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  latestAcceptableDate  DateTime?
  expiryDate            DateTime?

  // Immutable snapshots taken at confirmation — later changes to the
  // customer's live address must not rewrite what this order actually
  // shipped to (§5).
  invoiceAddressSnapshot  Json?
  deliveryAddressSnapshot Json?
  orderContactId    String?
  invoiceContactId  String?
  deliveryContactId String?

  netAmount      Int @default(0)
  discountAmount Int @default(0)
  taxAmount      Int @default(0)
  grossAmount    Int @default(0)

  internalNotes      String?
  customerNotes      String?
  deliveryInstructions String?

  cancelledAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  quote        Quote?       @relation(fields: [quoteId], references: [id])
  priceList    PriceList?   @relation(fields: [priceListId], references: [id])
  paymentTerm  PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  lines        SalesOrderLine[]
  holds        OrderHold[]
  changeEvents OrderChangeEvent[]
  approvals    OrderApproval[]

  @@unique([organisationId, reference])
  @@index([organisationId, commercialStatus])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String        @id @default(cuid())
  orderId       String
  lineNumber    Int
  type          OrderLineType @default(PRODUCT)

  productId             String?
  descriptionSnapshot   String
  customerProductReference String?

  orderedQuantity   Int     @default(1)
  cancelledQuantity Int     @default(0)
  unitOfMeasure     String  @default("each")

  unitPriceAmount Int
  priceSource     String? // e.g. "Northbridge 2026 Contract Price", "Standard price" — see pricing engine
  discountPercent Float?  @default(0)
  netAmount       Int
  taxCategory     String?
  taxAmount       Int     @default(0)

  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  warehousePreference   String?
  projectReference      String?
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@unique([orderId, lineNumber])
  @@map("sales_order_lines")
}

enum OrderHoldType {
  CREDIT
  PRICING_APPROVAL
  CUSTOMER_REQUEST
  COMPLIANCE
  STOCK_REVIEW
  DELIVERY_ISSUE
  MANUAL
}

// Reusable order holds (§30). The commercial order may continue to exist
// while operational release is blocked — a hold never deletes or hides the
// order itself.
model OrderHold {
  id               String        @id @default(cuid())
  orderId          String
  type             OrderHoldType
  reason           String?
  blockingScope     String? // e.g. "fulfilment", "all" — free text today, no enforcement engine yet
  releaseAuthority  String?
  createdByUserId   String
  createdAt         DateTime      @default(now())
  releasedByUserId  String?
  releasedAt        DateTime?

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_holds")
}

enum OrderChangeType {
  CUSTOMER
  QUANTITY
  PRICE
  PRODUCT
  REQUESTED_DATE
  DELIVERY_ADDRESS
  REFERENCE
  STATUS
  CANCELLATION
  PRICE_OVERRIDE
}

// Amendment history for confirmed orders (§36-37) — a change is recorded,
// never silently applied. Lets a future Logistics/Finance module know when
// confirmed commercial data it already acted on has since changed.
model OrderChangeEvent {
  id              String          @id @default(cuid())
  orderId         String
  lineId          String?
  type            OrderChangeType
  fromValue       String?
  toValue         String?
  reason          String?
  changedByUserId String
  createdAt       DateTime        @default(now())

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("sales_order_change_events")
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Approval requests raised by order confirmation rules (§43) — e.g. order
// value or discount above a threshold. No configurable rule engine yet;
// thresholds are fixed in src/modules/sales/services/order-approval-rules.ts,
// documented as a known simplification.
model OrderApproval {
  revision Int @default(1)
  decisionReason String?
  id              String              @id @default(cuid())
  orderId         String
  reason          String
  status          OrderApprovalStatus @default(PENDING)
  requestedByUserId String
  requestedAt       DateTime            @default(now())
  decidedByUserId   String?
  decidedAt         DateTime?

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_approvals")
}


model Project {
 id String @id @default(cuid())
 organisationId String
 partyId String
 name String
 reference String
 status String @default("PLANNED")
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 party Party @relation(fields:[partyId],references:[id])
 quotes Quote[]
 tasks ProjectTask[]
 meetings Meeting[]
 @@unique([organisationId,reference])
 @@index([organisationId,status])
 @@map("projects")
}


model ChatMessage {
 id String @id @default(cuid())
 organisationId String
 authorUserId String
 body String
 createdAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@index([organisationId,createdAt])
 @@map("chat_messages")
}
model Dashboard {
 id String @id @default(cuid())
 organisationId String
 userId String
 name String
 widgets String[]
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@unique([organisationId,userId,name])
 @@map("dashboards")
}

model Warehouse {
 id String @id @default(cuid())
 organisationId String
 name String
 code String
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 balances InventoryBalance[]
 movements InventoryMovement[]
 @@unique([organisationId,code])
 @@map("warehouses")
}
model InventoryBalance {
 id String @id @default(cuid())
 organisationId String
 warehouseId String
 productId String
 quantity Int @default(0)
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 warehouse Warehouse @relation(fields:[warehouseId],references:[id])
 product Product @relation(fields:[productId],references:[id])
 @@unique([warehouseId,productId])
 @@index([organisationId])
 @@map("inventory_balances")
}
model InventoryMovement {
 id String @id @default(cuid())
 organisationId String
 warehouseId String
 productId String
 delta Int
 reason String
 reference String?
 requestKey String
 actorUserId String
 createdAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 warehouse Warehouse @relation(fields:[warehouseId],references:[id])
 product Product @relation(fields:[productId],references:[id])
 @@unique([organisationId,requestKey])
 @@index([organisationId,createdAt])
 @@map("inventory_movements")
}
model Kpi {
 id String @id @default(cuid())
 organisationId String
 name String
 teamName String
 ownerUserId String
 unit String @default("count")
 direction String @default("AT_LEAST")
 target Float
 current Float @default(0)
 startsAt DateTime
 endsAt DateTime
 notes String?
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 updates KpiUpdate[]
 @@index([organisationId,endsAt])
 @@map("kpis")
}
model KpiUpdate {
 id String @id @default(cuid())
 kpiId String
 value Float
 note String?
 actorUserId String
 createdAt DateTime @default(now())
 kpi Kpi @relation(fields:[kpiId],references:[id],onDelete:Cascade)
 @@map("kpi_updates")
}
model ProjectTask {
 id String @id @default(cuid())
 organisationId String
 projectId String?
 meetingId String?
 title String
 assigneeUserId String
 status String @default("TODO")
 priority String @default("NORMAL")
 dueAt DateTime?
 createdAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 project Project? @relation(fields:[projectId],references:[id])
 meeting Meeting? @relation(fields:[meetingId],references:[id])
 @@index([organisationId,status])
 @@map("project_tasks")
}
model Meeting {
 id String @id @default(cuid())
 organisationId String
 projectId String?
 title String
 startsAt DateTime
 notes String?
 organiserUserId String
 attendeeUserIds String[]
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 project Project? @relation(fields:[projectId],references:[id])
 tasks ProjectTask[]
 @@index([organisationId,startsAt])
 @@map("meetings")
}

// Owner grants are independent of tenant-editable roles.
model PlatformAdministrator {
 userId String @id
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@map("platform_administrators")
}

// Templates contain catalogue references, never a duplicate product/customer identity.
model SalesQuotationTemplate {
  id String @id @default(cuid())
  organisationId String
  name String
  notes String?
  validityDays Int @default(30)
  lines Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  @@unique([organisationId,name])
  @@map("sales_quotation_templates")
}

model SalesOrderRevision {
  id String @id @default(cuid())
  orderId String
  revision Int
  snapshot Json
  reason String
  createdByUserId String
  createdAt DateTime @default(now())
  order SalesOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@unique([orderId,revision])
  @@map("sales_order_revisions")
}

// Core delivery envelope: downstream modules consume transactionally committed events.
model DomainOutbox {
  id String @id @default(cuid())
  organisationId String
  eventKey String @unique
  eventName String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  publishedAt DateTime?
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  @@index([status,createdAt])
  @@map("domain_outbox")
}

model SalesSavedView {
 id String @id @default(cuid())
 organisationId String
 ownerUserId String
 mode String
 name String
 definition Json
 archived Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@unique([organisationId,ownerUserId,mode,name])
 @@map("sales_saved_views")
}

// Editable, personal working quotations; never an authoritative confirmed sale.
model SalesWorkingDraft {
 captureVersion BigInt @default(0)
 id String @id
 organisationId String
 ownerUserId String
 mode String
 title String
 payload Json
 archived Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@index([organisationId,ownerUserId,archived])
 @@map("sales_working_drafts")
}

// ---------- HR (People) module ----------
// Employee is the HR module's own identity for internal staff — distinct from
// Party (Customer Master, for customers/suppliers). An Employee may optionally
// link to a User (a login account) but the HR record is authoritative for
// employment data and survives even where no login exists (e.g. not yet onboarded).

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  LEFT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  CONTRACTOR
  APPRENTICE
}

model Employee {
  id             String         @id @default(cuid())
  organisationId String
  userId         String?
  managerId      String?

  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  email          String
  phone          String?
  dateOfBirth    DateTime?

  jobTitle       String
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ONBOARDING)

  startDate      DateTime
  endDate        DateTime?
  leaveReason    String?

  annualSalaryMinorUnits Int?
  currency               String @default("GBP")
  annualLeaveDaysEntitlement Int @default(25)

  address        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  linkedUser   User?        @relation(fields: [userId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")

  onboardingTasks EmployeeTask[]
  appraisals      Appraisal[]
  oneToOnes       OneToOne[]
  absences        AbsenceRecord[]
  shifts          RotaShift[]
  payslips        Payslip[]

  @@unique([organisationId, employeeNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("hr_employees")
}

enum EmployeeTaskPhase {
  ONBOARDING
  OFFBOARDING
}

model EmployeeTask {
  id             String            @id @default(cuid())
  organisationId String
  employeeId     String
  phase          EmployeeTaskPhase
  title          String
  category       String?
  dueDate        DateTime?
  completedAt    DateTime?
  assignedToUserId String?
  notes          String?
  createdAt      DateTime          @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId, phase])
  @@map("hr_employee_tasks")
}

enum AppraisalStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AppraisalRating {
  EXCEEDS
  MEETS
  DEVELOPING
  UNSATISFACTORY
}

model Appraisal {
  id             String          @id @default(cuid())
  organisationId String
  employeeId     String
  reviewerUserId String
  cycle          String // e.g. "2026 H1 review"
  scheduledAt    DateTime
  completedAt    DateTime?
  status         AppraisalStatus @default(SCHEDULED)
  rating         AppraisalRating?
  strengths      String?
  areasForGrowth String?
  goals          String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId])
  @@map("hr_appraisals")
}

enum OneToOneStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model OneToOne {
  id             String         @id @default(cuid())
  organisationId String
  employeeId     String
  managerUserId  String
  scheduledAt    DateTime
  completedAt    DateTime?
  status         OneToOneStatus @default(SCHEDULED)
  talkingPoints  String?
  actionPoints   String?
  notes          String?
  createdAt      DateTime       @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId])
  @@map("hr_one_to_ones")
}

enum AbsenceType {
  SICKNESS
  HOLIDAY
  UNPAID
  COMPASSIONATE
  MATERNITY_PATERNITY
  OTHER
}

// Sickness episodes feed the Bradford Factor (S^2 * D over a rolling 12 months),
// computed on read in src/modules/people/domain/bradford-factor.ts — never stored,
// so the score is always correct for "today" regardless of when it's viewed.
model AbsenceRecord {
  id               String      @id @default(cuid())
  organisationId   String
  employeeId       String
  type             AbsenceType
  startDate        DateTime
  endDate          DateTime
  reason           String?
  certifiedByDoctor Boolean    @default(false)
  notes            String?
  createdAt        DateTime    @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId, type])
  @@map("hr_absence_records")
}

enum RotaShiftStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
}

model RotaShift {
  id             String          @id @default(cuid())
  organisationId String
  employeeId     String
  startsAt       DateTime
  endsAt         DateTime
  role           String?
  location       String?
  status         RotaShiftStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, startsAt])
  @@map("hr_rota_shifts")
}

enum PayrollRunStatus {
  DRAFT
  FINALISED
  PAID
}

model PayrollRun {
  id             String           @id @default(cuid())
  organisationId String
  periodLabel    String
  periodStart    DateTime
  periodEnd      DateTime
  status         PayrollRunStatus @default(DRAFT)
  finalisedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organisationId, periodLabel])
  @@index([organisationId])
  @@map("hr_payroll_runs")
}

model Payslip {
  id                  String     @id @default(cuid())
  organisationId      String
  payrollRunId        String
  employeeId          String
  grossMinorUnits      Int
  deductionsMinorUnits Int @default(0)
  netMinorUnits        Int
  currency             String @default("GBP")
  notes                String?
  createdAt            DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([organisationId])
  @@map("hr_payslips")
}
