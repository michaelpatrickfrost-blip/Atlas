  team         PlannerTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, teamId, startsOn])
  @@map("planner_handovers")
}

enum PlannerPlaceKind {
