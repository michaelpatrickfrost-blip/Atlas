// ---------- Customer Templates: flexible per-customer module configuration


// ===== Platform: durable events, company email/social (IT), automations, contracts, CSAT =====
model AutomationEvent {
  id String @id @default(cuid())
  organisationId String
  name String
  entityType String?
  entityId String?
  payload Json @default("{}")
  occurredAt DateTime @default(now())
  processedAt DateTime?
  @@index([organisationId,name,occurredAt])
  @@index([organisationId,occurredAt])
  @@map("automation_events")
}

model Automation {
  id String @id @default(cuid())
  organisationId String
  name String
  description String @default("")
  enabled Boolean @default(false)
  triggerType String @default("EVENT")
  triggerEvent String?
  schedule Json @default("{}")
  conditions Json @default("[]")
  steps Json @default("[]")
  ownerUserId String
  templateKey String?
  version Int @default(1)
  lastRunAt DateTime?
  runCount Int @default(0)
  failCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs AutomationRun[]
  @@unique([id,organisationId])
  @@index([organisationId,enabled,triggerEvent])
  @@map("automations")
}

model AutomationRun {
  id String @id @default(cuid())
  organisationId String
  automationId String
  eventId String?
  idempotencyKey String
  status String @default("RUNNING")
  dryRun Boolean @default(false)
  cursor Int @default(0)
  context Json @default("{}")
  results Json @default("[]")
  error String?
  resumeAt DateTime?
  attempts Int @default(0)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  automation Automation @relation(fields:[automationId,organisationId],references:[id,organisationId],onDelete:Cascade)
  @@unique([organisationId,idempotencyKey])
  @@index([organisationId,status,resumeAt])
  @@index([organisationId,automationId,startedAt])
  @@map("automation_runs")
}

model EmailAccount {
  id String @id @default(cuid())
  organisationId String
  scope String @default("COMPANY")
  ownerUserId String?
  label String
  fromName String @default("")
  fromEmail String
  replyTo String @default("")
  smtpHost String
  smtpPort Int @default(587)
  smtpSecurity String @default("STARTTLS")
  smtpUser String
  passwordEnc String @db.Text
  imapHost String @default("")
  imapPort Int @default(993)
  imapSecurity String @default("SSL")
  /** Inbox sign-in. Blank means the sending username. The password is shared with sending. */
  imapUser String @default("")
  /** Read replies into Atlas from this mailbox. */
  imapEnabled Boolean @default(false)
  imapStatus String @default("UNVERIFIED")
  imapError String?
  imapSyncedAt DateTime?
  imapLastUid Int @default(0)
  signatureHtml String @default("") @db.Text
  dailyLimit Int @default(500)
  isDefault Boolean @default(false)
  active Boolean @default(true)
  status String @default("UNVERIFIED")
  lastError String?
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id,organisationId])
  @@index([organisationId,scope,ownerUserId])
  @@map("email_accounts")
}
/** Mail received in a connected mailbox, matched to a customer where the sender is a known contact. */
model EmailInbound {
  id String @id @default(cuid())
  organisationId String
  accountId String
  uid Int
  messageId String?
  inReplyTo String?
  fromEmail String
  fromName String @default("")
  subject String @default("")
  text String @default("") @db.Text
  receivedAt DateTime
  partyId String?
  contactId String?
  /** The Atlas message this is a reply to, when the mail client kept the reference. */
  replyToMessageId String?
  createdAt DateTime @default(now())
  @@unique([accountId,uid])
  @@index([organisationId,receivedAt])
  @@index([organisationId,partyId,receivedAt])
  @@map("email_inbound")
}

