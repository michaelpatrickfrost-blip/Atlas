 endMinute Int
 crewCount Int @default(1)
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 workCentre ManufacturingWorkCentre @relation(fields:[workCentreId],references:[id],onDelete:Cascade)
 resource ManufacturingResource? @relation(fields:[resourceId],references:[id],onDelete:Cascade)
 @@index([organisationId,workCentreId,active])
 @@index([organisationId,resourceId,active])
 @@map("manufacturing_shifts")
}

