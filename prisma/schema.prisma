 organisationId String
 projectId String?
 meetingId String?
 parentTaskId String?
 milestoneId String?
 reference String? @unique
 title String
 description String @default("")
 taskType String @default("TASK")
 assigneeUserId String
 creatorUserId String @default("")
 contributorUserIds String[] @default([])
 visibility String @default("COMPANY")
 status String @default("TODO")
 priority String @default("NORMAL")
 startAt DateTime?
 dueAt DateTime?
 completedAt DateTime?
 waitingReason String?
 waitingUntil DateTime?
 estimatedMinutes Int @default(0)
 weight Int @default(1)
 position Int @default(0)
 recurrence String?
 tags String[] @default([])
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 project Project? @relation(fields:[projectId],references:[id])
 meeting Meeting? @relation(fields:[meetingId],references:[id])
 parentTask ProjectTask? @relation("Subtasks",fields:[parentTaskId],references:[id])
 subtasks ProjectTask[] @relation("Subtasks")
 milestone ProjectMilestone? @relation(fields:[milestoneId],references:[id])
 checklist ProjectChecklistItem[]
 predecessors ProjectDependency[] @relation("Successor")
 successors ProjectDependency[] @relation("Predecessor")
 workAudit AuditEntry[]
 timers ProjectTimer[]
 propertyValues ProjectPropertyValue[]
 timeEntries ProjectTimeEntry[]
 comments ProjectComment[]
 inbox ProjectInboxItem[]
 workLinks ProjectWorkLink[]
 personalPlans ProjectPersonalPlan[]
 chatMessages ChatMessage[]
 @@index([organisationId,status])
 @@index([organisationId,assigneeUserId,dueAt])
 @@map("project_tasks")
}
model Meeting {
 id String @id @default(cuid())
 organisationId String
 projectId String?
 title String
 startsAt DateTime
 notes String?
 organiserUserId String
 attendeeUserIds String[]
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 project Project? @relation(fields:[projectId],references:[id])
 tasks ProjectTask[]
 chatMessages ChatMessage[]
 @@index([organisationId,startsAt])
 @@map("meetings")
}

// Owner grants are independent of tenant-editable roles.
model PlatformAdministrator {
 userId String @id
 role String @default("OWNER")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@map("platform_administrators")
}

// Templates contain catalogue references, never a duplicate product/customer identity.
model SalesQuotationTemplate {
  id String @id @default(cuid())
  organisationId String
  name String
  notes String?
  validityDays Int @default(30)
  lines Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  @@unique([organisationId,name])
  @@map("sales_quotation_templates")
}

enum InvoiceTemplateKind {
  DOMESTIC
  EXPORT
}

// What prints on a customer's invoice. An export template raises a proforma with the sale.
model InvoiceDocumentTemplate {
  id             String              @id @default(cuid())
  organisationId String
  name           String
  kind           InvoiceTemplateKind
  blocks         String[]
  exporterEori   String?
  footer         String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments  CustomerInvoiceTemplate[]
  proformas    SalesProforma[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("invoice_document_templates")
}

// The template attached to one customer account, with the addresses that belong on their paperwork.
model CustomerInvoiceTemplate {
  id                String   @id @default(cuid())
  organisationId    String
  partyId           String
  templateId        String
  invoiceAddressId  String?
  deliveryAddressId String?
  notifyAddressId   String?
  buyerEori         String?
  buyerVat          String?
  marks             String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  party        Party                   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  template     InvoiceDocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  quotes       Quote[]                 @relation("QuoteInvoiceTemplate")
  orders       SalesOrder[]            @relation("OrderInvoiceTemplate")

  @@unique([partyId, templateId])
  @@index([organisationId, partyId])
  @@map("customer_invoice_templates")
}

// Export proforma raised with the sales order. It is not a tax invoice.
model SalesProforma {
  id                     String    @id @default(cuid())
  organisationId         String
  orderId                String    @unique
  templateId             String?
  reference              String
  status                 String    @default("DRAFT")
  incoterms              String?
  namedPlace             String?
  countryOfDestination   String?
  portOfLoading          String?
  portOfDischarge        String?
  packageCount           Int?
  packageType            String?
  marks                  String?
  reasonForExport        String?
  buyerEori              String?
  buyerVat               String?
  netWeightGrams         Int?
  grossWeightGrams       Int?
  volumeMl               Int?
  missing                String[]  @default([])
  snapshot               Json
  issuedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  order        SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template     InvoiceDocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([organisationId, reference])
  @@map("sales_proformas")
}

model SalesOrderRevision {
  id String @id @default(cuid())
  orderId String
  revision Int
  snapshot Json
  reason String
  createdByUserId String
  createdAt DateTime @default(now())
  order SalesOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@unique([orderId,revision])
  @@map("sales_order_revisions")
}

// Core delivery envelope: downstream modules consume transactionally committed events.
model DomainOutbox {
  id String @id @default(cuid())
  organisationId String
  eventKey String @unique
  eventName String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  publishedAt DateTime?
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  @@index([status,createdAt])
  @@map("domain_outbox")
}

model SalesSavedView {
 id String @id @default(cuid())
 organisationId String
 ownerUserId String
 mode String
 name String
 definition Json
 archived Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@unique([organisationId,ownerUserId,mode,name])
 @@map("sales_saved_views")
}

// Editable, personal working quotations; never an authoritative confirmed sale.
model SalesWorkingDraft {
 captureVersion BigInt @default(0)
 id String @id
 organisationId String
 ownerUserId String
 mode String
 title String
 payload Json
 archived Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 @@index([organisationId,ownerUserId,archived])
 @@map("sales_working_drafts")
}

// ---------- HR (People) module ----------
// Employee is the HR module's own identity for internal staff — distinct from
// Party (Customer Master, for customers/suppliers). An Employee may optionally
// link to a User (a login account) but the HR record is authoritative for
// employment data and survives even where no login exists (e.g. not yet onboarded).

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  LEFT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
  CONTRACTOR
  APPRENTICE
}

model Employee {
  id             String         @id @default(cuid())
  organisationId String
  userId         String?
  managerId      String?

  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  email          String
  phone          String?
  dateOfBirth    DateTime?

  jobTitle       String
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ONBOARDING)

  startDate      DateTime
  endDate        DateTime?
  leaveReason    String?

  annualSalaryMinorUnits Int?
  currency               String @default("GBP")
  annualLeaveDaysEntitlement Int @default(25)

  // Statutory payroll facts. Sensitive — every read/write in application code
  // goes through payroll.employee.manage, never the general HR employee read.
  // See src/modules/payroll/domain and docs/modules/PAYROLL.md.
  payFrequency        PayFrequency @default(MONTHLY)
  taxCode             String?
  niNumber            String?
  niCategory          String       @default("A")
  starterDeclaration  StarterDeclaration?
  studentLoanPlan     StudentLoanPlan?
  pensionOptOut       Boolean      @default(false)
  bankAccountName     String?
  bankSortCode        String?
  bankAccountNumber   String?

  address        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  linkedUser   User?        @relation(fields: [userId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")

  skills String[] @default([])
  appraisalCadenceMonths Int?
  oneToOneCadenceWeeks   Int?
  /** Overrides the org's standard weekly hours for overtime calculation — set
   *  this for part-time/fixed-term staff whose contracted hours differ from
   *  the org default. Null falls back to Organisation.hrStandardWeeklyHours. */
  contractedWeeklyHours  Float?

  privateNotes EmployeeNote[]
  timesheets Timesheet[]
  workingDays Int[] @default([1, 2, 3, 4, 5])
  onboardingTasks EmployeeTask[]
  appraisals      Appraisal[]
  oneToOnes       OneToOne[]
  absences        AbsenceRecord[]
  shifts          RotaShift[]
  payslips        Payslip[]
  taxYearToDates  EmployeeTaxYearToDate[]
  statutoryPayRecords StatutoryPayRecord[]
  payrollDocuments PayrollDocument[]
  history         EmployeeHistoryEvent[]
  documents       EmployeeDocument[]
  expenseClaims   ExpenseClaim[]
  performancePlans PerformancePlan[]
  goals            Kpi[]
  disciplinaryCases DisciplinaryCase[]
  plannerMemberships PlannerTeamMember[]
  plannerTasks PlannerTask[]
  plannerCoversAway PlannerCover[] @relation("PlannerCoverAway")
  plannerCoversFor PlannerCover[] @relation("PlannerCoverFor")
  plannerHandovers PlannerHandover[]
  plannerPlaces PlannerPlace[]

  @@unique([organisationId, employeeNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("hr_employees")
}

enum EmployeeTaskPhase {
  ONBOARDING
  OFFBOARDING
}

model EmployeeTask {
  id             String            @id @default(cuid())
  organisationId String
  employeeId     String
  phase          EmployeeTaskPhase
  title          String
  category       String?
  dueDate        DateTime?
  completedAt    DateTime?
  assignedToUserId String?
  notes          String?
  createdAt      DateTime          @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId, phase])
  @@map("hr_employee_tasks")
}

enum AppraisalStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AppraisalRating {
  EXCEEDS
  MEETS
  DEVELOPING
  UNSATISFACTORY
}

// A reusable, fixed question set for appraisals — e.g. "Engineering review":
// ["Delivery", "Code quality", "Collaboration"]. Answers live on the Appraisal
// itself (one appraisal, one answer set) rather than a join table — a template's
// questions are a flat ordered list, not independently reusable records.
model AppraisalTemplate {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  questions      String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  appraisals   Appraisal[]

  @@unique([organisationId, name])
  @@map("hr_appraisal_templates")
}

model Appraisal {
  id             String          @id @default(cuid())
  organisationId String
  employeeId     String
  reviewerUserId String
  templateId     String?
  cycle          String // e.g. "2026 H1 review"
  scheduledAt    DateTime
  completedAt    DateTime?
  status         AppraisalStatus @default(SCHEDULED)
  rating         AppraisalRating?
  strengths      String?
  areasForGrowth String?
  goals          String?
  notes          String?
  /** One entry per template question, in template order: { question, answer }[]. Null when no template was used. */
  answers        Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     AppraisalTemplate? @relation(fields: [templateId], references: [id])

  @@index([organisationId, employeeId])
  @@map("hr_appraisals")
}

enum OneToOneStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// A reusable set of talking points for one-to-ones — same pattern as
// AppraisalTemplate. Answers live on the OneToOne itself, not a join table.
model OneToOneTemplate {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  talkingPoints  String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  oneToOnes    OneToOne[]

  @@unique([organisationId, name])
  @@map("hr_one_to_one_templates")
}

model OneToOne {
  id             String         @id @default(cuid())
  organisationId String
  employeeId     String
  managerUserId  String
  templateId     String?
  scheduledAt    DateTime
  completedAt    DateTime?
  status         OneToOneStatus @default(SCHEDULED)
  talkingPoints  String?
  actionPoints   String?
  notes          String?
  /** One entry per template talking point, in order: { topic, notes }[]. Null when no template was used. */
  answers        Json?
  createdAt      DateTime       @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     OneToOneTemplate? @relation(fields: [templateId], references: [id])

  @@index([organisationId, employeeId])
  @@map("hr_one_to_ones")
}

enum AbsenceType {
  SICKNESS
  HOLIDAY
  UNPAID
  COMPASSIONATE
  MATERNITY_PATERNITY
  OTHER
}

// Sickness episodes feed the Bradford Factor (S^2 * D over a rolling 12 months),
// computed on read in src/modules/people/domain/bradford-factor.ts — never stored,
// so the score is always correct for "today" regardless of when it's viewed.
enum AbsenceRequestStatus {
  CANCELLED
  PENDING
  APPROVED
  REJECTED
}

model AbsenceRecord {
  id               String      @id @default(cuid())
  organisationId   String
  employeeId       String
  type             AbsenceType
  startDate        DateTime
  endDate          DateTime
  reason           String?
  certifiedByDoctor Boolean    @default(false)
  notes            String?
  /** PENDING only for self-requested leave awaiting a manager's decision.
   *  HR-logged absence (sickness, compassionate, etc.) defaults straight to
   *  APPROVED — it's a record of what happened, not a request. */
  status           AbsenceRequestStatus @default(APPROVED)
  approverUserId   String?
  approvedAt       DateTime?
  rejectionReason  String?
  bookedDays Float?
  createdAt        DateTime    @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  statutoryPayRecord StatutoryPayRecord?

  @@index([organisationId, employeeId, type])
  @@map("hr_absence_records")
}

enum RotaShiftStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
}

model RotaShift {
  id             String          @id @default(cuid())
  organisationId String
  employeeId     String
  startsAt       DateTime
  endsAt         DateTime
  role           String?
  location       String?
  status         RotaShiftStatus @default(SCHEDULED)
  notes          String?
  breakMinutes Int @default(0)
  workTypeId String?
  teamId String?
  workType SchedulingWorkType? @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  team WorkTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks ShiftTask[]
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, startsAt])
  @@index([organisationId, workTypeId])
  @@index([organisationId, teamId])
  @@map("hr_rota_shifts")
}

enum PayrollRunStatus {
  DRAFT
  FINALISED
  PAID
}

model PayrollRun {
  id             String           @id @default(cuid())
  organisationId String
  periodLabel    String
  periodStart    DateTime
  periodEnd      DateTime
  status         PayrollRunStatus @default(DRAFT)
  finalisedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organisationId, periodLabel])
  @@index([organisationId])
  @@map("hr_payroll_runs")
}

model Payslip {
  id                  String     @id @default(cuid())
  organisationId      String
  payrollRunId        String
  employeeId          String
  grossMinorUnits      Int
  overtimeHours        Float @default(0)
  overtimeMinorUnits   Int @default(0)
  unpaidLeaveDays      Int @default(0)
  unpaidLeaveDeductionMinorUnits Int @default(0)
  // Statutory lines. taxMinorUnits/employeeNiMinorUnits/studentLoanMinorUnits
  // are deducted from gross; employerNiMinorUnits/employerPensionMinorUnits
  // are employer cost, not deducted from the employee's net pay.
  taxMinorUnits               Int @default(0)
  employeeNiMinorUnits        Int @default(0)
  employerNiMinorUnits        Int @default(0)
  employeePensionMinorUnits   Int @default(0)
  employerPensionMinorUnits   Int @default(0)
  studentLoanMinorUnits       Int @default(0)
  statutoryPayMinorUnits      Int @default(0)
  // Manual, human-entered adjustment for anything the engine doesn't cover.
  deductionsMinorUnits Int @default(0)
  netMinorUnits        Int
  currency             String @default("GBP")
  notes                String?
  createdAt            DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([organisationId])
  @@map("hr_payslips")
}

enum PayFrequency {
  MONTHLY
  WEEKLY
}

enum StarterDeclaration {
  A
  B
  C
}

enum StudentLoanPlan {
  PLAN_1
  PLAN_2
  PLAN_4
  POSTGRADUATE
}

// One row per organisation per tax year. Not a per-employee setting — the
// employer's PAYE/Accounts Office references and pension defaults are the
// same for everyone paid through this organisation.
model PayrollSettings {
  id                     String   @id @default(cuid())
  organisationId         String   @unique
  payeReference          String?
  accountsOfficeReference String?
  currentTaxYear         String   // e.g. "2026-27"
  pensionSchemeName      String?
  employerPensionPercent Float    @default(3)
  employeePensionPercent Float    @default(5)
  updatedAt              DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

// Cumulative figures PAYE/NI need to calculate correctly period over period —
// one row per employee per tax year, updated as each payroll run finalises.
model EmployeeTaxYearToDate {
  id                  String   @id @default(cuid())
  organisationId       String
  employeeId          String
  taxYear              String // e.g. "2026-27"
  grossToDateMinorUnits Int    @default(0)
  taxToDateMinorUnits   Int    @default(0)
  niToDateMinorUnits    Int    @default(0)
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, taxYear])
  @@index([organisationId])
  @@map("payroll_tax_year_to_dates")
}

enum StatutoryPayType {
  SSP
  SMP
}

// Links one absence episode (SICKNESS or MATERNITY_PATERNITY) to the
// statutory pay the engine computed for it, so a payroll run can find and
// apply it without re-deriving qualifying days each time.
model StatutoryPayRecord {
  id               String           @id @default(cuid())
  organisationId   String
  employeeId       String
  absenceRecordId  String
  type             StatutoryPayType
  weeklyRateMinorUnits Int
  qualifyingDays   Int
  totalMinorUnits  Int
  createdAt        DateTime         @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  absenceRecord AbsenceRecord @relation(fields: [absenceRecordId], references: [id], onDelete: Cascade)

  @@unique([absenceRecordId])
  @@index([organisationId, employeeId])
  @@map("payroll_statutory_pay_records")
}

enum PayrollDocumentType {
  P45
  P60
}

// A record of a leaver/year-end document the engine generated for export —
// not a filing or HMRC submission. See docs/modules/PAYROLL.md.
model PayrollDocument {
  id             String              @id @default(cuid())
  organisationId String
  employeeId     String
  type           PayrollDocumentType
  taxYear        String
  figures        Json
  generatedAt    DateTime            @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId])
  @@map("payroll_documents")
}

// A plain-language record of changes to an employee over time (status, job title,
// manager) — auto-logged by the actions that make those changes, not hand-entered.
model EmployeeHistoryEvent {
  id             String   @id @default(cuid())
  organisationId String
  employeeId     String
  type           String // e.g. "STATUS_CHANGE", "JOB_TITLE_CHANGE", "MANAGER_CHANGE", "CREATED"
  description    String
  occurredAt     DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId])
  @@map("hr_employee_history_events")
}

// A reference to a document held elsewhere (contract, right-to-work evidence,
// certification) — Atlas has no file storage provider configured yet, so this
// stores metadata and a link rather than binary content. See docs/MODULE_SPEC.md
// "What modules must never access" — this does not invent new storage infra
// without an explicit provider decision.
model EmployeeDocument {
  id             String   @id @default(cuid())
  organisationId String
  employeeId     String
  title          String
  category       String?
  url            String?
  notes          String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId])
  @@map("hr_employee_documents")
}

enum ExpenseClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model ExpenseClaim {
  id             String             @id @default(cuid())
  organisationId String
  employeeId     String
  category       String
  description    String?
  amountMinorUnits Int
  currency       String             @default("GBP")
  incurredOn     DateTime
  status         ExpenseClaimStatus @default(PENDING)
  approverUserId String?
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime           @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, employeeId, status])
  @@map("hr_expense_claims")
}

enum HrPolicyAudience {
  EVERYONE
  MANAGERS
  HR
}

enum HrPolicyStatus {
  PUBLISHED
  ARCHIVED
}

// Company policy documents. The PDF bytes stay on the server. The generic read
// API never returns the file; opening a policy is a checked action.
model HrPolicy {
  id               String           @id @default(cuid())
  organisationId   String
  title            String
  category         String
